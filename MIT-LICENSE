Kira.TitanESPBillboards = {}

Kira.UpdateESP = function()
	if not workspace:FindFirstChild("Titans") then return end
	local col = getgenv().ESPColor or Color3.fromRGB(200, 200, 200)
	local char = Kira.Player.Character
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")

	if getgenv().TitanESP then
		for _, t in ipairs(workspace.Titans:GetChildren()) do
			if t:IsA("Model") then
				pcall(function()
					local h = t:FindFirstChildOfClass("Humanoid")
					if h and h.Health > 0 then
						-- Highlight
						if not Kira.TitanHL[t] then
							local hl = Instance.new("Highlight")
							hl.Adornee = t
							hl.FillTransparency = 0.88
							hl.OutlineColor = Kira.BossNames[t.Name] and Color3.fromRGB(255, 55, 55) or col
							hl.OutlineTransparency = 0.25
							hl.Parent = t
							Kira.TitanHL[t] = hl
						elseif not Kira.BossNames[t.Name] then
							Kira.TitanHL[t].OutlineColor = col
						end

						-- Billboard: distance + state
						local rootPart = t.PrimaryPart or t:FindFirstChildWhichIsA("BasePart")
						if rootPart then
							local bb = Kira.TitanESPBillboards[t]
							if not bb then
								bb = Instance.new("BillboardGui")
								bb.Name = "KiraESP_Label"
								bb.Size = UDim2.new(0, 120, 0, 36)
								bb.StudsOffset = Vector3.new(0, 18, 0)
								bb.AlwaysOnTop = true
								bb.Adornee = rootPart
								bb.Parent = rootPart

								local lbl = Instance.new("TextLabel")
								lbl.Name = "Info"
								lbl.Size = UDim2.new(1, 0, 1, 0)
								lbl.BackgroundTransparency = 1
								lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
								lbl.TextStrokeTransparency = 0.4
								lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
								lbl.TextScaled = true
								lbl.Font = Enum.Font.GothamBold
								lbl.Parent = bb
								Kira.TitanESPBillboards[t] = bb
							end

							-- Update label text
							local lbl = bb:FindFirstChild("Info")
							if lbl then
								local dist = hrp and math.floor((hrp.Position - rootPart.Position).Magnitude) or 0
								local stateAttr = t:GetAttribute("Attack") or t:GetAttribute("State") or "Idle"
								local stateStr  = tostring(stateAttr)
								-- Map internal state names to readable labels
								if stateStr == "Berserk_Mode" then stateStr = "Berserk"
								elseif stateStr == "" or stateStr == "nil" then stateStr = "Idle" end
								local isBoss = Kira.BossNames[t.Name]
								local nameStr = isBoss and ("[BOSS] " .. t.Name:gsub("_", " ")) or t.Name:gsub("_", " ")
								lbl.Text = nameStr .. "\n" .. tostring(dist) .. " studs | " .. stateStr
								lbl.TextColor3 = isBoss and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(230, 230, 230)
							end
						end
					else
						-- Titan dead — cleanup
						if Kira.TitanHL[t] then
							Kira.TitanHL[t]:Destroy()
							Kira.TitanHL[t] = nil
						end
						if Kira.TitanESPBillboards[t] then
							Kira.TitanESPBillboards[t]:Destroy()
							Kira.TitanESPBillboards[t] = nil
						end
					end
				end)
			end
		end
	else
		for _, hl in pairs(Kira.TitanHL) do
			pcall(function() hl:Destroy() end)
		end
		Kira.TitanHL = {}
		for _, bb in pairs(Kira.TitanESPBillboards) do
			pcall(function() bb:Destroy() end)
		end
		Kira.TitanESPBillboards = {}
	end
end

