local function GetPrestigeData()
	local slot = player:GetAttribute("Slot")
	local ok, result = pcall(function() return getRemote:InvokeServer("Functions", "Settings", "Blur", "Off") end)
	if ok and type(result) == "table" and result.Slots then
		local data = slot and result.Slots[slot] or result.Slots.A
		if data then return data end
	end
	return nil
end

local function GetSkoovbTSQuestData()
	local data = GetPrestigeData()
	if data and type(data.Quests) == "table" then
		return data.Quests.Spears
	end
	return nil
end

local function QueryTSQuestProgress(tag)
	local questTable = GetSkoovbTSQuestData()
	if type(questTable) ~= "table" then return 0, false, false end
	for _, q in pairs(questTable) do
		if type(q) == "table" and tag == q.Tag then
			return q.Current or 0, q.Rewarded == true, true
		end
	end
	return 0, false, false
end

local function GetTSPieceInventoryCount()
	local data = GetPrestigeData()
	local inv = data and data.Inventory
	if type(inv) ~= "table" then return 0 end
	local count = 0
	for _, piece in ipairs(getgenv().KiraHub.Data.TSPieces) do
		local owned = false
		local items = inv.Items
		if items and type(items) == "table" and type(items[piece]) == "number" and items[piece] >= 1 then
			owned = true
		end
		if not owned then
			for _, category in pairs(inv) do
				if type(category) == "table" and type(category[piece]) == "number" and category[piece] >= 1 then
					owned = true
					break
				end
			end
		end
		if owned then count = count + 1 end
	end
	return count
end

local function IsTSQuestCompleted()
	if GetTSPieceInventoryCount() >= 3 then return true end
	local completedPieces = 0
	for _, stage in ipairs(getgenv().KiraHub.Data.TSStages) do
		if stage.Piece then
			local _, rewarded = QueryTSQuestProgress(stage.Tag)
			if rewarded then completedPieces = completedPieces + 1 end
		end
	end
	return completedPieces >= 3
end

local function VerifyPreconditions(stage)
	if not stage.PreReq then return true end
	for _, s in ipairs(getgenv().KiraHub.Data.TSStages) do
		if s.Tag == stage.PreReq then
			local current, rewarded = QueryTSQuestProgress(s.Tag)
			return rewarded or (current >= s.Amount)
		end
	end
	return true
end

local function LocatePendingTSQuestStage()
	for _, stage in ipairs(getgenv().KiraHub.Data.TSStages) do
		local current, rewarded, active = QueryTSQuestProgress(stage.Tag)
		if not rewarded and VerifyPreconditions(stage) then
			return stage, current, active
		end
	end
	return nil
end

local function VerifyTSEligibility()
	if not IsToggled("AutoTSQuestToggle") then return false end
	if IsTSQuestCompleted() then return false end
	local prestige = player:GetAttribute("Prestige")
	if not prestige then
		local data = GetPrestigeData()
		prestige = data and data.Progression and data.Progression.Prestige or 0
	end
	local requirementGate = GetOption("ThunderSpearPrestigeSlider", 4)
	return prestige >= requirementGate
end

local function ClaimTSQuestRewards()
	local claimed = 0
	for _, stage in ipairs(getgenv().KiraHub.Data.TSStages) do
		local current, rewarded, active = QueryTSQuestProgress(stage.Tag)
		if active and not rewarded and current >= stage.Amount then
			local ok, result = pcall(getRemote.InvokeServer, getRemote, "Functions", "Quest", stage.Tag, "Spears")
			if ok and result ~= nil then
				claimed = claimed + 1
			end
		end
	end
	return claimed
end

local function ExecuteAutomaticPrestigeSequencer()
	if not IsToggled("AutoPrestigeToggle") then return end
	if game.PlaceId ~= LOBBY_ID then return end
	local slot = player:GetAttribute("Slot")
	if not slot then return end
	local profile = GetPlayerData()
	if not profile or not profile.Slots or not profile.Slots[slot] then return end
	local slotConfig = profile.Slots[slot]
	local activeGold = nil
	pcall(function()
		local updatedData = getRemote:InvokeServer("Functions", "Settings", "Blur", "Off")
		if type(updatedData) == "table" and updatedData.Slots then
			local activeSlotData = updatedData.Slots[slot] or updatedData.Slots.A
			if activeSlotData and activeSlotData.Currency then
				activeGold = activeSlotData.Currency.Gold
			end
		end
	end)
	if not activeGold then
		activeGold = slotConfig.Currency and slotConfig.Currency.Gold or 0
	end
	local prestige = player:GetAttribute("Prestige") or 0
	local targetPrestige = GetOption("PrestigeTargetSlider", 0)
	if targetPrestige > 0 and targetPrestige <= prestige then
		SetToggle("AutoPrestigeToggle", false)
		Library:Notify({Title = "Auto Prestige", Description = "Reached target prestige level " .. prestige, Time = 5})
		return
	end
	local level = player:GetAttribute("Level") or 0
	local maxLevelForPrestige = 100 + prestige * 25
	if level < maxLevelForPrestige then
		getgenv().KiraHub.State.PrestigeWaiting = false
		return
	end
	if IsToggled("AutoTSQuestToggle") and (prestige >= GetOption("ThunderSpearPrestigeSlider", 4) and not IsTSQuestCompleted()) then
		getgenv().KiraHub.State.TSQuestActive = true
		getgenv().KiraHub.State.PrestigeWaiting = false
		return
	end
	local nextPrestigeTier = math.clamp(prestige + 1, 1, 5)
	local boostSelection = GetOption("P" .. nextPrestigeTier .. "BoostDropdown", "Gold Boost")
	local goldRequirement = GetOption("P" .. nextPrestigeTier .. "GoldSlider", 0) * 1000000
	if goldRequirement > 0 and activeGold < goldRequirement then
		getgenv().KiraHub.State.PrestigeWaiting = false
		return
	end
	getgenv().KiraHub.State.PrestigeWaiting = true
	local talentsModule = nil
	local nextTalents = nil
	pcall(function()
		local mod = ReplicatedStorage:FindFirstChild("Modules")
		local storage = mod and mod:FindFirstChild("Storage")
		local memories = storage and storage:FindFirstChild("Memories")
		if memories then talentsModule = require(memories) end
	end)
	pcall(function()
		local ok, result = pcall(getRemote.InvokeServer, getRemote, "S_Equipment", "Talents")
		if ok and type(result) == "table" then nextTalents = result end
	end)
	if not nextTalents then
		pcall(function()
			local slotData = GetPrestigeData()
			if slotData and slotData.Next_Talents then nextTalents = slotData.Next_Talents end
		end)
	end
	local prestigeTriggered = false
	if nextTalents and #nextTalents > 0 then
		local evaluatedTalents = {}
		for _, talentId in ipairs(nextTalents) do
			local matchedTag = (function(id)
				if not talentsModule or type(talentsModule.Talents) ~= "table" then return nil end
				local strId = tostring(id)
				for _, memory in pairs(talentsModule.Talents) do
					if type(memory) == "table" and memory[strId] then return memory[strId].Tag end
				end
				return nil
			end)(talentId)
			if matchedTag and not evaluatedTalents[matchedTag] then
				evaluatedTalents[matchedTag] = true
				local ok, result = pcall(function()
					return getRemote:InvokeServer("S_Equipment", "Prestige", {Boosts = boostSelection, Talents = matchedTag})
				end)
				if ok and result then
					prestigeTriggered = true
					break
				end
			end
		end
	end
	if not prestigeTriggered then
		for _, talent in ipairs(getgenv().KiraHub.Data.Talents) do
			local ok, result = pcall(function()
				return getRemote:InvokeServer("S_Equipment", "Prestige", {Boosts = boostSelection, Talents = talent})
			end)
			if ok and result then
				prestigeTriggered = true
				break
			end
		end
	end
	task.wait(2)
	local validatedPrestige = player:GetAttribute("Prestige") or 0
	if validatedPrestige > prestige then
		Library:Notify({Title = "Prestige Executed!", Description = "Advanced to prestige " .. validatedPrestige .. " with " .. boostSelection, Time = 5})
		getgenv().KiraHub.State.PrestigeWaiting = false
		getgenv().KiraHub.State.PrestigeFailedAttempts = 0
	else
		getgenv().KiraHub.State.PrestigeFailedAttempts = (getgenv().KiraHub.State.PrestigeFailedAttempts or 0) + 1
		if getgenv().KiraHub.State.PrestigeFailedAttempts >= 3 then
			getgenv().KiraHub.State.PrestigeWaiting = false
			getgenv().KiraHub.State.PrestigeFailedAttempts = 0
		else
			Library:Notify({
				Title = "Prestige Failed",
				Description = "Retrying prestige sequence... (" .. tostring(getgenv().KiraHub.State.PrestigeFailedAttempts) .. "/3)",
				Time = 3
			})
		end
	end
	pcall(function()
		local data = getRemote:InvokeServer("Data", "Copy")
		if data then lastPlayerData = data end
	end)
	task.wait(3)
end

local function ExecuteAutomaticTSQuestResolver()
	pcall(ClaimTSQuestRewards)
	if not VerifyTSEligibility() then
		getgenv().KiraHub.State.TSQuestActive = false
		return
	end
	getgenv().KiraHub.State.TSQuestActive = true
	local currentStage, currentCount, active = LocatePendingTSQuestStage()
	if not currentStage then
		pcall(function() getgenv().KiraHub.UI.Labels.TSStatus:SetText("TS: claiming completed stages") end)
		task.wait(2)
		return
	end
	if currentCount >= currentStage.Amount then
		pcall(ClaimTSQuestRewards)
		task.wait(2)
		return
	end
	pcall(function()
		getgenv().KiraHub.UI.Labels.TSStatus:SetText("TS: " .. currentStage.Tag .. " (" .. currentCount .. "/" .. currentStage.Amount .. ")")
	end)
	if game.PlaceId == LOBBY_ID then
		local activeMissions = ReplicatedStorage:FindFirstChild("Missions")
		local playerActiveMission = nil
		if activeMissions then
			for _, m in ipairs(activeMissions:GetChildren()) do
				if m:FindFirstChild("Leader") and m.Leader.Value == player.Name then
					playerActiveMission = m
					break
				end
			end
		end
		if playerActiveMission then
			local mapMatched = playerActiveMission.Name == currentStage.Map
			if not mapMatched then
				pcall(function() getRemote:InvokeServer("S_Missions", "Leave") end)
				task.wait(1)
			else
				if currentStage.AllMods then
					for _, mod in ipairs(getgenv().KiraHub.Data.AllModifiers) do
						pcall(function() getRemote:InvokeServer("S_Missions", "Modify", mod) end)
					end
					task.wait(0.3)
				end
				pcall(function() getRemote:InvokeServer("S_Missions", "Start") end)
				task.wait(5)
			end
		else
			pcall(function()
				getRemote:InvokeServer("S_Missions", "Create", {
					Difficulty = currentStage.Difficulty or "Aberrant",
					Type = "Missions",
					Name = currentStage.Map,
					Objective = currentStage.Objective
				})
			end)
			task.wait(0.6)
		end
	else
		if currentStage.ForceRemote then
			local remoteDetails = currentStage.ForceRemote
			pcall(function()
				getRemote:InvokeServer(remoteDetails[1], remoteDetails[2], remoteDetails[3])
			end)
		end
		if currentStage.CollectCrates then
			pcall(function()
				local char = player.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				if not root then return end
				local crates = {}
				for _, v in ipairs(workspace:GetDescendants()) do
					if v:IsA("Model") and string.find(v.Name, "ThunderSpear_Supplies", 1, true) then
						table.insert(crates, v)
					end
				end
				for _, v in ipairs(crates) do
					local pivot = v:GetPivot()
					root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
					root.CFrame = pivot * CFrame.new(0, 3, 3)
					local waitTime = GetOption("TSPickupWaitSlider", 4)
					task.wait(waitTime)
					local circle = GetSuppliesCircle()
					if circle then
						local circlePivot = circle:GetPivot()
						root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
						root.CFrame = circlePivot * CFrame.new(0, 3, 0)
						task.wait(2)
					end
				end
			end)
		end
	end
end

