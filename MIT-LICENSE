local function GetBanStatus()
	local bl = player:GetAttribute("Blacklisted") == true
	local ex = player:GetAttribute("Exploiter") == true
	if bl and ex then
		getgenv().KiraHub.State.BanStatus = "Banned"
	elseif bl or ex then
		getgenv().KiraHub.State.BanStatus = "Flagged"
	else
		getgenv().KiraHub.State.BanStatus = "Clean"
	end
	return getgenv().KiraHub.State.BanStatus
end

local function FireRewardWebhook(eventType, data)
	local url = GetWebhookURL()
	if url == "" then return end
	if not IsToggled("ToggleRewardWebhook") and eventType ~= "Mythical" and eventType ~= "SkinHunter" then return end
	if eventType == "Mythical" and not IsToggled("ToggleMythicalFamilyWebhook") then return end
	if eventType == "SkinHunter" and not IsToggled("ToggleSkinHunterWebhook") then return end
	local username = IsToggled("RewardsShowUsernameToggle") and player.Name or "Anonymous"
	pcall(function()
		PostWebhook(url, {
			embeds = {{
				title = "⚜ Kira Hub Premium | " .. eventType,
				description = data.description or ("Event: " .. eventType),
				color = data.color or 14495578,
				fields = data.fields or { {name = "Player", value = username, inline = true} },
				footer = {text = "Kira Hub ⚜ Premium | kira_scripts.gg"},
				timestamp = DateTime.now():ToIsoDate()
			}}
		})
	end)
end

