local function snd(id, vol, pitch)
    task.spawn(function()
        local s = Instance.new("Sound")
        s.SoundId = id
        s.Volume = vol or 0.4
        s.Pitch = pitch or 1
        s.Parent = SoundService
        s:Play()
        s.Ended:Wait()
        s:Destroy()
    end)
end

local function tw(o, p, d, s, dir)
    local t = TweenService:Create(o, TweenInfo.new(d or 0.3, s or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), p)
    t:Play()
    return t
end

local function clip(t)
    pcall(function()
        if setclipboard then setclipboard(t)
        elseif toclipboard then toclipboard(t) end
    end)
end

