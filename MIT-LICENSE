local function dismiss()
    playSound("rbxassetid://6895079853", 0.9, 0.4)
    tw(Overlay, {BackgroundTransparency = 1}, 0.3)
    tw(MainStroke, {Transparency = 1}, 0.25)
    tw(MainFrame, {Position = UDim2.new(0.5, -280, 0.55, -270), BackgroundTransparency = 1}, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In)
    for _, child in ipairs(MainFrame:GetDescendants()) do
        if child:IsA("TextLabel") or child:IsA("TextBox") or child:IsA("TextButton") then
            tw(child, {TextTransparency = 1}, 0.2)
        elseif child:IsA("ImageLabel") then
            tw(child, {ImageTransparency = 1}, 0.2)
        end
        if child:IsA("Frame") or child:IsA("TextButton") then
            tw(child, {BackgroundTransparency = 1}, 0.2)
        end
    end
    task.delay(0.35, function()
        ScreenGui:Destroy()
    end)
end

