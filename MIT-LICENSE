local function SaveSessionState()
	pcall(function()
		local payload = {
			StartTime = getgenv().KiraHub.State.StartTime,
			TotalGold = getgenv().KiraHub.State.TotalGold,
			TotalGems = getgenv().KiraHub.State.TotalGems,
			TotalXP = getgenv().KiraHub.State.TotalXP,
			MythicalDrops = getgenv().KiraHub.State.MythicalDrops,
			Crashes = getgenv().KiraHub.State.Crashes,
			GamesPlayed = getgenv().KiraHub.State.GamesPlayed
		}
		writefile(CFG_MASTER_FILE, HttpService:JSONEncode(payload))
	end)
end

local function LoadSessionState()
	pcall(function()
		if isfile(CFG_MASTER_FILE) then
			local content = readfile(CFG_MASTER_FILE)
			local decoded = HttpService:JSONDecode(content)
			if type(decoded) == "table" then
				for k, v in pairs(decoded) do
					if k ~= "StartTime" then
						getgenv().KiraHub.State[k] = v
					end
				end
			end
		end
		if isfile(CFG_GAMES_FILE) then
			local val = tonumber(readfile(CFG_GAMES_FILE))
			if val then getgenv().KiraHub.State.GamesPlayed = val end
		end
	end)
end

