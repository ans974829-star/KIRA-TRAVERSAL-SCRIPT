Kira.Toggles.AutoStartToggle:OnChanged(function()
	getgenv().AutoStart = Kira.Toggles.AutoStartToggle.Value
	if getgenv().AutoStart and Kira.IsLobby then
		task.spawn(function()
			local MAX_RETRIES = 10
			local retries = 0
			while getgenv().AutoStart do
				for _, mission in ipairs(Kira.Services.ReplicatedStorage.Missions:GetChildren()) do
					if mission:FindFirstChild("Leader") and mission.Leader.Value == Kira.Player.Name then
						Kira.GetRemote:InvokeServer("S_Missions", "Leave")
					end
				end
				local missionType = Kira.Options.StartTypeDropdown and Kira.Options.StartTypeDropdown.Value or "Missions"
				local selectedDifficulty, mapName, objective
				if missionType == "Missions" then
					selectedDifficulty = Kira.Options.MissionDifficultyDropdown and Kira.Options.MissionDifficultyDropdown.Value or "Hardest"
					mapName = Kira.Options.MissionMapDropdown and Kira.Options.MissionMapDropdown.Value or "Shiganshina"
					objective = Kira.Options.MissionObjectiveDropdown and Kira.Options.MissionObjectiveDropdown.Value or "Skirmish"
				elseif missionType == "Raids" then
					selectedDifficulty = Kira.Options.RaidDifficultyDropdown and Kira.Options.RaidDifficultyDropdown.Value or "Hardest"
					mapName = Kira.Options.RaidMapDropdown and Kira.Options.RaidMapDropdown.Value or "Trost"
					objective = Kira.RaidObjectives[mapName] or "Attack Titan"
					mapName = Kira.RaidMapNames[mapName] or mapName
				elseif missionType == "Waves" then
					selectedDifficulty = "Easy"
					mapName = Kira.Options.WavesMapDropdown and Kira.Options.WavesMapDropdown.Value or "Trost"
					objective = "Waves"
				end
				local created = false
				if selectedDifficulty == "Hardest" then
					local diffOrder = (missionType == "Raids") and {"Aberrant", "Severe", "Hard"} or {"Aberrant", "Severe", "Hard", "Normal", "Easy"}
					for _, diff in ipairs(diffOrder) do
						if not getgenv().AutoStart then break end
						Kira.GetRemote:InvokeServer("S_Missions", "Create", {
							Difficulty = diff,
							Type = (missionType == "Raids") and "Raids" or missionType,
							Name = mapName,
							Objective = objective
						})
						if Kira.GetMyMission() then
							Kira.LibraryInstance:Notify({Title = "Auto Start", Description = "Created " .. tostring(diff) .. " mission", Time = 2})
							created = true
							break
						end
					end
				else
					Kira.GetRemote:InvokeServer("S_Missions", "Create", {
						Difficulty = selectedDifficulty,
						Type = (missionType == "Raids") and "Raids" or missionType,
						Name = mapName,
						Objective = objective
					})
					if Kira.GetMyMission() then created = true end
				end
				if not getgenv().AutoStart then break end
				if not created then
					retries = retries + 1
					if retries >= MAX_RETRIES then
						Kira.LibraryInstance:Notify({Title = "Auto Start", Description = "Failed after " .. tostring(MAX_RETRIES) .. " retries. Stopping.", Time = 6})
						getgenv().AutoStart = false
						Kira.Toggles.AutoStartToggle:SetValue(false)
						break
					end
					local backoff = math.min(retries * 2, 20)
					Kira.LibraryInstance:Notify({Title = "Auto Start", Description = "Failed. Retry " .. tostring(retries) .. "/" .. tostring(MAX_RETRIES) .. " in " .. tostring(backoff) .. "s", Time = backoff})
					task.wait(backoff)
					continue
				end
				retries = 0
				local activeMods = {}
				if Kira.Options.ModifiersDropdown and Kira.Options.ModifiersDropdown.Value then
					for modName, isActive in pairs(Kira.Options.ModifiersDropdown.Value) do
						if isActive then table.insert(activeMods, modName) end
					end
				end
				for _, modifier in ipairs(activeMods) do
					Kira.GetRemote:InvokeServer("S_Missions", "Modify", modifier)
				end
				task.wait(0.5)
				if getgenv().WaitBeforeStart and getgenv().WaitBeforeStartSecs > 0 then
					Kira.LibraryInstance:Notify({Title = "Auto Start", Description = "Waiting " .. tostring(getgenv().WaitBeforeStartSecs) .. "s before starting...", Time = getgenv().WaitBeforeStartSecs})
					task.wait(getgenv().WaitBeforeStartSecs)
				end
				Kira.GetRemote:InvokeServer("S_Missions", "Start")
				task.wait(5)
			end
		end)
	end
	Kira.MarkDirty()
end)

