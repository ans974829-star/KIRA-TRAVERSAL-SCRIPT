	local root = Kira.Player.Character and Kira.Player.Character:FindFirstChild("HumanoidRootPart")
	if not root then return false end
	offset = offset or Vector3.new(0, 3, 0)
	if part:IsA("BasePart") then
		root.CFrame = part.CFrame * CFrame.new(offset)
	elseif part:IsA("Model") then
		local primary = part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart")
		if primary then
			root.CFrame = primary.CFrame * CFrame.new(offset)
		end
	end
	root.AssemblyLinearVelocity = Kira.V3Zero
	return true
end

