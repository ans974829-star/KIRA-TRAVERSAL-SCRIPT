local function dismiss()
    snd("rbxassetid://6895079853", 0.3, 0.8)
    tw(bg, {BackgroundTransparency = 1}, 0.35)
    tw(glowTL, {ImageTransparency = 1}, 0.3)
    tw(glowBR, {ImageTransparency = 1}, 0.3)
    for _, c in ipairs(gui:GetDescendants()) do
        if c:IsA("GuiObject") then
            if c:FindFirstChildOfClass("UICorner") or c:IsA("Frame") then
                tw(c, {BackgroundTransparency = 1}, 0.25)
            end
            if c:IsA("TextLabel") or c:IsA("TextBox") or c:IsA("TextButton") then
                tw(c, {TextTransparency = 1}, 0.2)
            end
            if c:IsA("ImageLabel") then
                tw(c, {ImageTransparency = 1}, 0.2)
            end
            if c:IsA("UIStroke") then
                tw(c, {Transparency = 1}, 0.2)
            end
        end
    end
    task.delay(0.4, function() gui:Destroy() end)
end

