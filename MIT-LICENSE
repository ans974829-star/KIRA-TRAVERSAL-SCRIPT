		for depth = 1, 5 do
			if not part or not part.Parent then break end
			if getgenv().KiraHub.Data.BossNames[part.Name] then result = true break end
			if getgenv().KiraHub.Data.BossNames[part.Parent.Name] then result = true break end
			part = part.Parent
		end
	end)
	return result
end

local function IsWavesMode()
	return workspace:FindFirstChild("Waves") ~= nil
end

local function StripVisualFilters()
	pcall(function()
		for _, v in ipairs(Lighting:GetChildren()) do
			if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("BloomEffect") or v:IsA("BlurEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("SunRaysEffect") then
				v:Destroy()
			end
		end
		pcall(function() Lighting.Brightness = 2 end)
		pcall(function() Lighting.GlobalShadows = false end)
	end)
end

local function RemoveFog()
	pcall(function()
		Lighting.FogEnd = 1000000
		Lighting.FogStart = 0
		local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
		if atmo then
			atmo.Density = 0
			atmo.Glare = 0
			atmo.Haze = 0
		end
	end)
end

local function DeleteMap()
	pcall(function()
		for _, v in ipairs(workspace:GetChildren()) do
			if v.Name == "Objects" or v.Name == "Map" or v.Name == "Decals" then
				if not v:IsA("Terrain") then v:Destroy() end
			end
		end
	end)
end

local function ApplyPerformanceStrip()
	pcall(function()
		for _, v in ipairs(workspace:GetDescendants()) do
			if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Smoke") or v:IsA("Fire") then
				pcall(function() v.Enabled = false end)
			elseif v:IsA("Decal") or v:IsA("Texture") then
				pcall(function() v.Transparency = 1 end)
			end
		end
	end)
end

local crashCheckActive = false
local function ManageCrashDetection(enabled)
	if crashCheckActive == enabled then return end
	crashCheckActive = enabled
	if not enabled then return end
	task.spawn(function()
		while crashCheckActive do
			task.wait(10)
			if not IsToggled("AutoRejoinToggle") then continue end
			if isLobby or isMenu then continue end
			if IsWavesMode() then continue end
			if not IsToggled("AutoKillToggle") then continue end
			if not workspace:FindFirstChild("Titans") and not workspace:FindFirstChild("Unclimbable") then
				task.wait(10)
				if not workspace:FindFirstChild("Titans") and not workspace:FindFirstChild("Unclimbable") then
