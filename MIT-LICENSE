									if shootOk then break end
									task.wait(0.1)
								end
								task.wait(1.8)
							end
							impactConn:Disconnect()
							pcall(function() getRemote:InvokeServer("Cannon", "State", cannonModel, false) end)
							self._colossalCannon = false
						end)
					end
				else
					self._colossalCannon = false
					if not self._colossalPhase2 then
						self._colossalPhase2 = true
						task.spawn(function()
							while self._running do
								local tf = workspace:FindFirstChild("Titans")
								local ct = tf and tf:FindFirstChild("Colossal_Titan")
								if not ct then task.wait(0.5) continue end
								local hit = ct:FindFirstChild("Hitboxes") and ct.Hitboxes:FindFirstChild("Hit")
								if not hit then task.wait(0.5) continue end
								local napePart = hit:FindFirstChild("Nape")
								if not napePart then task.wait(0.5) continue end
								local napePos = napePart.Position + Vector3.new(0, 4, 0)
								local weaponUsed = GetCurrentWeapon()
								if weaponUsed == "Spears" then
									for i = 1, 15 do
										pcall(function() postRemote:FireServer("Spears", "S_Explode", napePos) end)
									end
								else
									pcall(function() postRemote:FireServer("Attacks", "Slash", true) end)
								end
								local bossHits = GetOption("BladeBossHitsSlider", 35)
								local hitsPerTick = 5
								for batch = 1, math.ceil(bossHits / hitsPerTick) do
									for j = 1, math.min(hitsPerTick, bossHits - (batch - 1) * hitsPerTick) do
										pcall(function()
											postRemote:FireServer("Hitboxes", "Register", napePart, math.random(625, 850))
										end)
									end
									task.wait()
								end
								task.wait(0.05)
							end
							self._colossalPhase2 = false
						end)
						task.spawn(function()
							while self._colossalPhase2 do
								task.wait(0.5)
								local rsObj = ReplicatedStorage:FindFirstChild("Objectives")
								local defendEren = rsObj and rsObj:FindFirstChild("Defend_Eren")
								local defendBoats = rsObj and rsObj:FindFirstChild("Defend_Boats")
								if not defendEren and not defendBoats then continue end
