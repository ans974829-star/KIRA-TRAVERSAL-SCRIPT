local function createActionButton(name, iconText, btnText, bgColor, hoverColor, onClick)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(0.5, -5, 1, 0)
    btn.BackgroundColor3 = bgColor
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.Parent = SocialRow

    local bCorner = Instance.new("UICorner")
    bCorner.CornerRadius = UDim.new(0, 8)
    bCorner.Parent = btn

    local bStroke = Instance.new("UIStroke")
    bStroke.Color = Color3.fromRGB(50, 50, 50)
    bStroke.Thickness = 1
    bStroke.Parent = btn

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.Text = iconText .. " " .. btnText
    label.TextColor3 = Color3.fromRGB(240, 240, 240)
    label.TextSize = 12
    label.Parent = btn

    btn.MouseEnter:Connect(function()
        tw(btn, {BackgroundColor3 = hoverColor}, 0.2)
        playSound("rbxassetid://6895079853", 1.2, 0.3)
    end)
    btn.MouseLeave:Connect(function()
        tw(btn, {BackgroundColor3 = bgColor}, 0.2)
    end)
    btn.MouseButton1Click:Connect(function()
        playSound("rbxassetid://6895079853", 1, 0.5)
        onClick(label)
    end)
end

