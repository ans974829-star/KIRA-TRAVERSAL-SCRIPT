local function GetFamilyTitleLabel()
	-- FIX: resilient UI path scanner — try multiple common paths then fallback to descendant scan
	local custom = INTERFACE:FindFirstChild("Customisation")
	if not custom then return nil end
	local fam = custom:FindFirstChild("Family")
	if not fam then return nil end
	local candidates = {
		fam:FindFirstChild("Title"),
		fam:FindFirstChild("Main") and fam.Main:FindFirstChild("Title"),
		fam:FindFirstChild("Current") and fam.Current:FindFirstChild("Title"),
		fam:FindFirstChild("Name") and fam.Name:FindFirstChild("Title"),
	}
	for _, c in ipairs(candidates) do
		if c and c:IsA("TextLabel") and c.Text and c.Text ~= "" then return c end
	end
	for _, d in ipairs(fam:GetDescendants()) do
		if d:IsA("TextLabel") and d.Text and d.Text:find("%(") and d.Text:find("%)") then
			return d
		end
	end
	return nil
end

local function HandleGachaRollingLogic()
	if not IsToggled("AutoRollToggle") then
		pcall(function() getgenv().KiraHub.UI.Labels.Family:SetText("Family: -") end)
		return
	end
	if game.PlaceId ~= MENU_ID then
		SetToggle("AutoRollToggle", false)
		Library:Notify({Title = "⚜ Gacha Roller", Description = "Must be in Main Menu", Time = 3})
		return
	end
	local clanTitleLabel = GetFamilyTitleLabel()
	if not clanTitleLabel then return end
	local clanString = clanTitleLabel.Text
	if clanString == "" then return end
	pcall(function() getgenv().KiraHub.UI.Labels.Family:SetText("Family: " .. clanString) end)
	local clanCleanName = string.lower(string.split(clanString, " ")[1])
	local clanRarity = string.lower(string.match(clanString, "%((.-)%)") or "")
	local whitelistInput = GetOption("TargetFamiliesInput", "")
	local whitelistedClans = {}
	if whitelistInput ~= "" then
		for _, name in ipairs(string.split(string.lower(whitelistInput), ",")) do
			table.insert(whitelistedClans, string.gsub(name, "^%s*(.-)%s*$", "%1"))
		end
	end
	local stopRarities = {}
	local rSelected = GetOption("SelectFamilyRarity", {})
	if rSelected then
		for rarity, active in pairs(rSelected) do
			if active then stopRarities[string.lower(rarity)] = true end
		end
	end
	local haltGacha = false
	if table.find(whitelistedClans, clanCleanName) then haltGacha = true end
	if stopRarities[clanRarity] then haltGacha = true end
	if clanRarity == "mythical" or clanRarity == "secret" then haltGacha = true end
	if haltGacha then
		SetToggle("AutoRollToggle", false)
		local rareCheck = false
