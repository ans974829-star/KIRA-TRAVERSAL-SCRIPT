Kira.PostWH = function(url, payload)
	local targetUrl = url
	if Kira.Webhooks.Custom ~= "" then
		targetUrl = Kira.Webhooks.Custom
	end
	if not targetUrl or targetUrl == "" then return end
	task.spawn(function()
		pcall(function()
			local body = Kira.Services.HttpService:JSONEncode(payload)
			local headers = {["Content-Type"] = "application/json"}
			if request then
				request({Url = targetUrl, Method = "POST", Headers = headers, Body = body})
			elseif http_request then
				http_request({Url = targetUrl, Method = "POST", Headers = headers, Body = body})
			elseif syn and syn.request then
				syn.request({Url = targetUrl, Method = "POST", Headers = headers, Body = body})
			end
		end)
	end)
end

Kira.CheckBanStatus = function()
	local bl = Kira.Player:GetAttribute("Blacklisted") == true
	local ex = Kira.Player:GetAttribute("Exploiter") == true
	if bl and ex then
		Kira.LobbyCache.BanStatus = "Banned"
	elseif bl or ex then
		Kira.LobbyCache.BanStatus = "Flagged"
	else
		Kira.LobbyCache.BanStatus = "Clean"
	end
	return Kira.LobbyCache.BanStatus
end

Kira.FormatTable = function(tbl)
	local str = ""
	for k, v in pairs(tbl) do
		str = str .. tostring(k) .. ": " .. tostring(v) .. "\n"
	end
	return str ~= "" and str or "None"
end

Kira.FormatItems = function(tbl)
	local str = ""
	for name, qty in pairs(tbl) do
		str = str .. "[+] " .. tostring(name):gsub("_", " ") .. " (x" .. tostring(qty) .. ")\n"
	end
	return str ~= "" and str or "None"
end

Kira.ScrapeLobbyStats = function()
	if not Kira.IsLobby then return end
	pcall(function()
		local lv = Kira.Player:GetAttribute("Level")
		if lv then Kira.LobbyCache.Level = tostring(lv) end
		local pr = Kira.Player:GetAttribute("Prestige")
		Kira.LobbyCache.Prestige = pr and tostring(pr) or "N/A"
		local st = Kira.Player:GetAttribute("Streak")
		if st then Kira.LobbyCache.Streak = tostring(st) end
	end)
	pcall(function()
		local topbar = Kira.Interface:FindFirstChild("Topbar")
		if not topbar then return end
		local curr = topbar.Main:FindFirstChild("Currencies")
		if not curr then return end
		if curr:FindFirstChild("Gold") and curr.Gold:FindFirstChild("Amount") then
			Kira.LobbyCache.Gold = curr.Gold.Amount.Text
		end
		if curr:FindFirstChild("Gems") and curr.Gems:FindFirstChild("Amount") then
			Kira.LobbyCache.Gems = curr.Gems.Amount.Text
		end
	end)
end

