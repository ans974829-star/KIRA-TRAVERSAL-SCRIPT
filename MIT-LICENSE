local M_UpGroup = Kira.Tabs.Upgrades:AddLeftGroupbox("Gear Upgrades", "hammer")

M_UpGroup:AddToggle("AutoUpgradeToggle", {Text = "Upgrade Gear", Default = false})
Kira.Toggles.AutoUpgradeToggle:OnChanged(function()
	getgenv().AutoUpgrade = Kira.Toggles.AutoUpgradeToggle.Value
	if not getgenv().AutoUpgrade then return end
	task.spawn(function()
		if game.PlaceId ~= Kira.LobbyId then
			Kira.LibraryInstance:Notify({Title = "Upgrade", Description = "Only works in lobby", Time = 3})
			getgenv().AutoUpgrade = false
			Kira.Toggles.AutoUpgradeToggle:SetValue(false)
			return
		end
		local slot = Kira.Player:GetAttribute("Slot")
		if not slot then
			pcall(function()
				Kira.GetRemote:InvokeServer("Functions", "Select", "A")
			end)
			local w = 0
			repeat
				task.wait(0.5)
				w = w + 0.5
			until Kira.Player:GetAttribute("Slot") or w >= 5
			slot = Kira.Player:GetAttribute("Slot")
		end
		if not slot then
			getgenv().AutoUpgrade = false
			Kira.Toggles.AutoUpgradeToggle:SetValue(false)
			return
		end
		local allUpgrades = {
			"Crit_Damage", "Crit_Chance",
			"ODM_Damage", "ODM_Control", "ODM_Gas", "ODM_Speed", "Blade_Durability", "ODM_Range",
			"Blast_Radius", "TS_Control", "TS_Range", "TS_Damage", "TS_Gas", "TS_Speed"
		}
		while getgenv().AutoUpgrade do
			local anyDone = false
			for _, upg in ipairs(allUpgrades) do
				if not getgenv().AutoUpgrade then break end
				local ok, result = pcall(function()
					return Kira.GetRemote:InvokeServer("S_Equipment", "Upgrade", {upg})
				end)
				if ok and result ~= nil and result ~= false then
					anyDone = true
					Kira.LibraryInstance:Notify({Title = "Upgraded!", Description = upg:gsub("_", " "), Time = 1.5})
					task.wait(0.5)
				end
			end
			if not anyDone then
				task.wait(10)
			else
				task.wait(1)
			end
		end
	end)
	Kira.MarkDirty()
end)

