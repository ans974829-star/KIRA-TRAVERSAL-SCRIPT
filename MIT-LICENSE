Kira.ManageAutoEquipPerks = function()
	local pData = Kira.GetPlayerData()
	local slot = Kira.Player:GetAttribute("Slot") or "A"
	local slotData = pData and pData.Slots and pData.Slots[slot]
	if not slotData or type(slotData.Perks) ~= "table" then return end
	local storage = slotData.Perks.Storage or {}
	local equipped = slotData.Perks.Equipped or {}
	local offenseEquipped = equipped.Offense and storage[equipped.Offense]
	local bodyEquipped = equipped.Body and storage[equipped.Body]
	local offenseValid = offenseEquipped and (offenseEquipped.Name == "Carnifex" or offenseEquipped.Name == "Kengo" or offenseEquipped.Name == "Butcher")
	local bodyValid = bodyEquipped and (bodyEquipped.Name == "Carnifex" or bodyEquipped.Name == "Kengo" or bodyEquipped.Name == "Butcher")
	if offenseValid and bodyValid then return end
	local candidates = {}
	for id, perk in pairs(storage) do
		if perk.Name == "Carnifex" then
			table.insert(candidates, {id = id, name = perk.Name, priority = 1})
		elseif perk.Name == "Kengo" then
			table.insert(candidates, {id = id, name = perk.Name, priority = 2})
		elseif perk.Name == "Butcher" then
			table.insert(candidates, {id = id, name = perk.Name, priority = 3})
		end
	end
	table.sort(candidates, function(a, b) return a.priority < b.priority end)
	local used = {}
	if not offenseValid then
		for _, cand in ipairs(candidates) do
			if not used[cand.id] then
				local ok, res = pcall(function()
					return Kira.GetRemote:InvokeServer("S_Equipment", "Perk_State", cand.id, "Equip", "Offense")
				end)
				if ok and res then
					used[cand.id] = true
					break
				end
			end
		end
		task.wait(0.3)
	end
	if not bodyValid then
		for _, cand in ipairs(candidates) do
			if not used[cand.id] then
				local ok, res = pcall(function()
					return Kira.GetRemote:InvokeServer("S_Equipment", "Perk_State", cand.id, "Equip", "Body")
				end)
				if ok and res then
					used[cand.id] = true
					break
				end
			end
		end
	end
end

