		if type(list) == "table" then
			for _, q in pairs(list) do
				if type(q) == "table" and q.Tag and q.Rewarded == nil then
					-- FIX: support Max / Goal / Amount field names
					local maxVal = tonumber(q.Max or q.Goal or q.Amount or q.Required) or 0
					local curVal = tonumber(q.Current) or 0
					if curVal >= maxVal and maxVal > 0 then
						local ok = pcall(function()
							getRemote:InvokeServer("Functions", "Quest", q.Tag, cat)
						end)
						if ok then claimed = claimed + 1 end
						task.wait(0.1)
					end
				end
			end
		end
	end
	if claimed > 0 then
		pcall(function()
			Library:Notify({Title = "⚜ Quests", Description = "Claimed " .. claimed .. " quest reward(s)", Time = 2})
		end)
	end
