local titanHL = {}
local titanEspLabels = {}

local function ClearAllESP()
	for _, hl in pairs(titanHL) do pcall(function() hl:Destroy() end) end
	table.clear(titanHL)
	for _, gui in pairs(titanEspLabels) do pcall(function() gui:Destroy() end) end
	table.clear(titanEspLabels)
end

local function UpdateTitanESP()
	local enabled = IsToggled("TitanESPToggle")
	local fullEnabled = IsToggled("FullTitanESPToggle")
	local color = getgenv().KiraHub.State.EspColorObj or Color3.fromRGB(212, 175, 55)
	local titansFolder = workspace:FindFirstChild("Titans")
	if not titansFolder then
		ClearAllESP()
		return
	end
	local seen = {}
	for _, titan in ipairs(titansFolder:GetChildren()) do
		if titan:IsA("Model") then
			seen[titan] = true
			if enabled then
				if not titanHL[titan] then
					local hl = Instance.new("Highlight")
					hl.Name = "KiraESP_Outline"
					hl.FillColor = color
					hl.OutlineColor = Color3.fromRGB(255, 215, 0)
					hl.FillTransparency = 0.65
					hl.OutlineTransparency = 0
					hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					hl.Adornee = titan
					hl.Parent = titan
					titanHL[titan] = hl
				else
					titanHL[titan].FillColor = color
				end
			else
				if titanHL[titan] then
					pcall(function() titanHL[titan]:Destroy() end)
					titanHL[titan] = nil
				end
			end
			if fullEnabled then
				if not titanEspLabels[titan] then
					local head = titan:FindFirstChild("Fake") and titan.Fake:FindFirstChild("Head")
					if head then
						local existing = head:FindFirstChild("Header")
						if existing then pcall(function() existing:Destroy() end) end
						local header = Instance.new("BillboardGui")
						header.Name = "Header"
						header.Adornee = head
						header.Size = UDim2.new(0, 220, 0, 60)
						header.StudsOffset = Vector3.new(0, 5, 0)
						header.AlwaysOnTop = true
						header.Parent = head
						local nameLabel = Instance.new("TextLabel")
						nameLabel.Name = "NameLabel"
						nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
						nameLabel.BackgroundTransparency = 1
						nameLabel.TextColor3 = color
						nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
						nameLabel.TextStrokeTransparency = 0
						nameLabel.Font = Enum.Font.GothamBold
						nameLabel.TextSize = 14
						nameLabel.Text = titan.Name
						nameLabel.Parent = header
						local infoLabel = Instance.new("TextLabel")
						infoLabel.Name = "InfoLabel"
						infoLabel.Size = UDim2.new(1, 0, 0.5, 0)
						infoLabel.Position = UDim2.new(0, 0, 0.5, 0)
						infoLabel.BackgroundTransparency = 1
						infoLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
						infoLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
						infoLabel.TextStrokeTransparency = 0
						infoLabel.Font = Enum.Font.Gotham
						infoLabel.TextSize = 11
						infoLabel.Text = ""
						infoLabel.Parent = header
						titanEspLabels[titan] = header
					end
				end
				local head = titan:FindFirstChild("Fake") and titan.Fake:FindFirstChild("Head")
				if head then
					local header = head:FindFirstChild("Header")
					if header then
						local infoLabel = header:FindFirstChild("InfoLabel")
						if infoLabel then
							local char = player.Character
							local myRoot = char and char:FindFirstChild("HumanoidRootPart")
							local distance = 0
							if myRoot then
								local pivotPos = titan.PrimaryPart and titan.PrimaryPart.Position or titan:GetModelBoundingBox().Position
								distance = math.floor((myRoot.Position - pivotPos).Magnitude)
							end
							local state = titan:GetAttribute("State") or titan:GetAttribute("Attack") or "Idle"
							local skinAttr = titan:GetAttribute("Skin") or ""
							infoLabel.Text = distance .. " studs | " .. tostring(state) .. (skinAttr ~= "" and (" | " .. tostring(skinAttr)) or "")
						end
					end
				end
			else
				if titanEspLabels[titan] then
					pcall(function() titanEspLabels[titan]:Destroy() end)
					titanEspLabels[titan] = nil
				end
			end
		end
	end
	for titan, hl in pairs(titanHL) do
		if not seen[titan] then
			pcall(function() hl:Destroy() end)
			titanHL[titan] = nil
		end
	end
	for titan, gui in pairs(titanEspLabels) do
		if not seen[titan] then
			pcall(function() gui:Destroy() end)
			titanEspLabels[titan] = nil
		end
	end
end

