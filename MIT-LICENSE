Kira.PrestigeEngineLoop = function()
	local pData = Kira.GetPlayerData()
	local slot = Kira.Player:GetAttribute("Slot") or "A"
	local slotData = pData and pData.Slots and pData.Slots[slot]
	if not slotData or not slotData.Progression then return end
	local currentPrestige = Kira.Player:GetAttribute("Prestige") or slotData.Progression.Prestige or 0
	local targetLimit = Kira.Options.PrestigeTargetSlider and Kira.Options.PrestigeTargetSlider.Value or 0
	if targetLimit > 0 and currentPrestige >= targetLimit then
		getgenv().AutoPrestige = false
		if Kira.Toggles.AutoPrestigeToggle then
			Kira.Toggles.AutoPrestigeToggle:SetValue(false)
		end
		return
	end
	local currentLevel = Kira.Player:GetAttribute("Level") or slotData.Progression.Level or 0
	local maxLevel = 100 + currentPrestige * 25
	if currentLevel < maxLevel then return end
	if getgenv().AutoThunderSpear and currentPrestige >= (getgenv().ThunderSpearAtPrestige or 4) and not Kira.TSQuestDone() then
		return
	end
	local nextP = math.clamp(currentPrestige + 1, 1, 5)
	local boostOpt = Kira.Options["P" .. tostring(nextP) .. "BoostDropdown"]
	local goldOpt = Kira.Options["P" .. tostring(nextP) .. "GoldSlider"]
	local chosenBoost = boostOpt and boostOpt.Value or "Gold Boost"
	local minGold = goldOpt and (goldOpt.Value * 1000000) or 0
	local playerGold = (slotData.Currency and slotData.Currency.Gold) or 0
	if minGold > 0 and playerGold < minGold then return end
	for _, memory in ipairs(Kira.Talents) do
		if not getgenv().AutoPrestige then break end
		local ok, res = pcall(function()
			return Kira.GetRemote:InvokeServer("S_Equipment", "Prestige", {Boosts = chosenBoost, Talents = memory})
		end)
		if ok and res then
			Kira.LibraryInstance:Notify({
				Title = "Prestige Complete!",
				Description = "P" .. tostring(currentPrestige + 1) .. " with " .. tostring(chosenBoost),
				Time = 4
			})
			break
		end
		task.wait(0.1)
	end
end

Kira.UnlockSkillsLoop = function()
	local pData = Kira.GetPlayerData()
	local slot = Kira.Player:GetAttribute("Slot") or "A"
	local slotData = pData and pData.Slots and pData.Slots[slot]
	if not slotData then return end
	local weaponType = Kira.Options.WeaponTypeDropdown and Kira.Options.WeaponTypeDropdown.Value or "Blades"
	local middle = Kira.Options.MiddlePathDropdown and Kira.Options.MiddlePathDropdown.Value or "Damage"
	local left = Kira.Options.LeftPathDropdown and Kira.Options.LeftPathDropdown.Value or "Cooldown Reduction"
	local right = Kira.Options.RightPathDropdown and Kira.Options.RightPathDropdown.Value or "Damage Reduction"
	local p1 = Kira.Options.Priority1Dropdown and Kira.Options.Priority1Dropdown.Value or "Middle"
	local p2 = Kira.Options.Priority2Dropdown and Kira.Options.Priority2Dropdown.Value or "Left"
	local p3 = Kira.Options.Priority3Dropdown and Kira.Options.Priority3Dropdown.Value or "None"
	local pathMap = {
		Left = Kira.SkillPaths.Support[left],
		Middle = Kira.SkillPaths[weaponType] and Kira.SkillPaths[weaponType][middle],
		Right = Kira.SkillPaths.Defense[right]
	}
	local paths, used = {}, {}
	local function addPath(p)
		if not used[p] and pathMap[p] then
			table.insert(paths, pathMap[p])
			used[p] = true
		end
	end
	addPath(p1)
	addPath(p2)
	addPath(p3)
	for _, path in ipairs(paths) do
		for _, skillId in ipairs(path) do
			if not getgenv().AutoSkillTree then break end
			pcall(function()
				Kira.GetRemote:InvokeServer("S_Equipment", "Unlock", {tostring(skillId)})
			end)
			task.wait(0.2)
		end
	end
end

