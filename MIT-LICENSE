				if ob.Gold and ob.Gold > 0 then items["Gold"] = tostring(ob.Gold) end
				if ob.XP and ob.XP > 0 then items["XP"] = tostring(ob.XP) end
				if ob.Gems and ob.Gems > 0 then items["Gems"] = tostring(ob.Gems) end
				if ob.Canes and ob.Canes > 0 then items["Canes"] = tostring(ob.Canes) end
				if ob.Shards and ob.Shards > 0 then items["Shards"] = tostring(ob.Shards) end
				if ob.Silver and ob.Silver > 0 then items["Silver"] = tostring(ob.Silver) end
				if ob.BP_XP and ob.BP_XP > 0 then items["BP XP"] = tostring(ob.BP_XP) end
				if ob.Perks then for _, pn in ipairs(ob.Perks) do items["Perk: " .. pn] = "1" end end
				if ob.Drops then
					for itemId, itemName in pairs(ob.Drops) do
						local name = tostring(itemName)
						dropsData[tostring(itemId)] = name
						local existing = tonumber(items[name]) or 0
						items[name] = tostring(existing + 1)
					end
				end
				if ob.Chests then
					for cn, cq in pairs(ob.Chests) do
						if cq and cq > 0 then items["Chest: " .. cn] = tostring(cq) end
					end
				end
				if ob.Perks then
					for _, pn in ipairs(ob.Perks) do
						if getgenv().KiraHub.Data.PerkRarityMap[pn] == "Secret" then
							special["Perk: " .. pn] = "1"
						end
					end
				end
			end
		end)

		if itemsFrame then
			for _, v in ipairs(itemsFrame:GetChildren()) do
				if v:IsA("Frame") and v:FindFirstChild("Main") then
					local inner = v.Main:FindFirstChild("Inner")
					if inner and inner:FindFirstChild("Rarity")
						and inner.Rarity.BackgroundColor3 == Color3.fromRGB(255, 0, 0)
					then
						local qty = inner:FindFirstChild("Quantity")
						local itemId = string.match(tostring(v.Name), "(%d+)$")
						local displayName = (itemId and dropsData[itemId]) or v.Name
						if not special[displayName] then
							special[displayName] = qty and qty.Text or "1"
							getgenv().KiraHub.State.MythicalDrops = getgenv().KiraHub.State.MythicalDrops + 1
						end
					end
				end
			end
		end

		pcall(function()
