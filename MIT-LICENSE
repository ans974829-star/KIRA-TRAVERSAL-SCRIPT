local function IsToggled(name)
	local T = getgenv().KiraHub.UI and getgenv().KiraHub.UI.Toggles
	if T and T[name] then return T[name].Value == true end
	return false
end

local function GetOption(name, default)
	local O = getgenv().KiraHub.UI and getgenv().KiraHub.UI.Options
	if O and O[name] then
		local val = O[name].Value
		if val ~= nil then return val end
	end
	return default
end

