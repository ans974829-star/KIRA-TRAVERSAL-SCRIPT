Kira.ExportConfig = function()
	local lib = Kira.LibraryInstance
	if not lib then return end
	local T, O = lib.Toggles, lib.Options
	local lines = {}
	local reverseToggleMap, reverseSliderMap, reverseDropdownMap = {}, {}, {}
	for friendly, toggleName in pairs(Kira.ToggleMap) do reverseToggleMap[toggleName] = friendly end
	for friendly, sliderName in pairs(Kira.SliderMap) do reverseSliderMap[sliderName] = friendly end
	for friendly, dropdownName in pairs(Kira.DropdownMap) do reverseDropdownMap[dropdownName] = friendly end
	for toggleName, toggle in pairs(T) do
		local friendly = reverseToggleMap[toggleName]
		if friendly then table.insert(lines, "\t" .. friendly .. " = " .. tostring(toggle.Value) .. ",") end
	end
	for sliderName, defaultVal in pairs(Kira.SliderDefaults) do
		if O[sliderName] then
			local friendly = reverseSliderMap[sliderName]
			local currentVal = O[sliderName].Value
			if friendly and currentVal ~= defaultVal then
				table.insert(lines, "\t" .. friendly .. " = " .. tostring(currentVal) .. ",")
			end
		end
	end
	for dropdownName, _ in pairs(reverseDropdownMap) do
		if O[dropdownName] then
			local friendly = reverseDropdownMap[dropdownName]
			local val = O[dropdownName].Value
			if friendly and type(val) == "string" and val ~= "" then
				table.insert(lines, "\t" .. friendly .. " = \"" .. val .. "\",")
			end
		end
	end
	if O["ModifiersDropdown"] then
		local val = O["ModifiersDropdown"].Value
		if type(val) == "table" then
			local hasAny = false
			for _, v in pairs(val) do if v == true then hasAny = true break end end
			if hasAny then
				table.insert(lines, "\tModifiers = {")
				for modName, isActive in pairs(val) do
					if isActive then table.insert(lines, "\t\t[\"" .. modName .. "\"] = true,") end
				end
				table.insert(lines, "\t},")
			end
		end
	end
	local result = "getgenv().KiraHubAotrConfig = {\n"
	for _, line in ipairs(lines) do result = result .. line .. "\n" end
	result = result .. "}\nloadstring(game:HttpGet(\"" .. Kira.AutoExecuteUrl .. "\"))()"
	pcall(setclipboard, result)
	pcall(function()
		lib:Notify({Title = "Config Exported", Description = "Config copied to clipboard", Time = 4})
	end)
end

Kira.ApplyImportedConfig = function(cfg)
	if not cfg or type(cfg) ~= "table" then return end
	task.spawn(function()
		task.wait(2)
		local lib = Kira.LibraryInstance
		if not lib then return end
		if cfg.toggles then
			for name, val in pairs(cfg.toggles) do
				if lib.Toggles[name] then pcall(function() lib.Toggles[name]:SetValue(val) end) end
			end
		end
		if cfg.sliders then
			for name, val in pairs(cfg.sliders) do
				if lib.Options[name] then pcall(function() lib.Options[name]:SetValue(val) end) end
			end
		end
		if cfg.dropdowns then
			for name, val in pairs(cfg.dropdowns) do
				if lib.Options[name] then pcall(function() lib.Options[name]:SetValue(val) end) end
			end
		end
	end)
end

Kira.ApplyFlatConfig = function(cfg)
	if not cfg or type(cfg) ~= "table" then return end
	task.spawn(function()
		task.wait(2)
		local lib = Kira.LibraryInstance
		if not lib then return end
		for key, val in pairs(cfg) do
			local toggleName = Kira.ToggleMap[key]
			if toggleName and lib.Toggles[toggleName] then
				pcall(function() lib.Toggles[toggleName]:SetValue(val) end)
				continue
			end
			local sliderName = Kira.SliderMap[key]
			if sliderName and lib.Options[sliderName] then
				pcall(function() lib.Options[sliderName]:SetValue(val) end)
				continue
			end
			local dropdownName = Kira.DropdownMap[key]
			if dropdownName and lib.Options[dropdownName] then
				pcall(function() lib.Options[dropdownName]:SetValue(val) end)
				continue
			end
			if key == "Modifiers" and type(val) == "table" and lib.Options["ModifiersDropdown"] then
				pcall(function() lib.Options["ModifiersDropdown"]:SetValue(val) end)
				continue
			end
			if lib.Toggles[key] then
				pcall(function() lib.Toggles[key]:SetValue(val) end)
				continue
			end
			if lib.Options[key] then
				pcall(function() lib.Options[key]:SetValue(val) end)
			end
		end
	end)
end

pcall(function()
