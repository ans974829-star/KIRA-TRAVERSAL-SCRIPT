	if workspace:GetAttribute("Type") then return true end
	local ok, result = pcall(function() return getRemote:InvokeServer("Data", "Copy") end)
	if ok and result then mapData = result end
	return mapData ~= nil and mapData.Map ~= nil and mapData.Slots ~= nil
end

