Kira.ManualAutoAttackLoop = function()
	task.spawn(function()
		while true do
			task.wait(0.1)
			if not getgenv().KiraHubAOTR then break end
			if not getgenv().ManualAutoAttack then continue end
			if getgenv().AutoFarm then continue end
			if getgenv().EmergencyStop then continue end
			if Kira.IsLobby then continue end
			local char = Kira.Player.Character
			if not char then continue end
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if not hrp then continue end
			local tf = workspace:FindFirstChild("Titans")
			if not tf then continue end
			local closestNape, closestDist = nil, 40
			for _, t in ipairs(tf:GetChildren()) do
				pcall(function()
					if t:GetAttribute("Killed") or t:GetAttribute("Dead") then return end
					local hum = t:FindFirstChildOfClass("Humanoid")
					if not hum or hum.Health <= 0 then return end
					local hit = t:FindFirstChild("Hitboxes") and t.Hitboxes:FindFirstChild("Hit")
					if not hit then return end
					local nape = hit:FindFirstChild("Nape")
					if nape then
						local dist = (hrp.Position - nape.Position).Magnitude
						if dist < closestDist then
							closestDist = dist
							closestNape = nape
						end
					end
				end)
			end
			if closestNape then
				Kira.PostRemote:FireServer("Attacks", "Slash", true)
				Kira.PostRemote:FireServer("Hitboxes", "Register", closestNape, math.random(625, 850))
				task.wait(0.2)
			end
		end
	end)
end
