local function HandleTitanSkinMatchmaking()
	if not IsToggled("SkinHunterToggle") then
		pcall(function() getgenv().KiraHub.UI.Labels.SkinHunter:SetText("Status: Idle") end)
		return
	end
	local targetSkinFriendlyName = GetOption("TargetSkinDropdown", "Onikiri Skin")
	local cleanSkinName = string.gsub(targetSkinFriendlyName, " Skin", "")
	local targetRaidMapName = getgenv().KiraHub.Data.SkinToRaidMap[cleanSkinName]
	local bossName = getgenv().KiraHub.Data.SkinToBoss[cleanSkinName]
	if not targetRaidMapName or not bossName then return end
	if game.PlaceId == LOBBY_ID then
		pcall(function() getgenv().KiraHub.UI.Labels.SkinHunter:SetText("Status: Queueing " .. targetRaidMapName) end)
		local activeMissions = ReplicatedStorage:FindFirstChild("Missions")
		local registeredMission = nil
		if activeMissions then
			for _, m in ipairs(activeMissions:GetChildren()) do
				if m:FindFirstChild("Leader") and m.Leader.Value == player.Name then
					registeredMission = m
					break
				end
			end
		end
		if registeredMission then
			local mapNameMatched = registeredMission.Name == targetRaidMapName
			if not mapNameMatched then
				pcall(function() getRemote:InvokeServer("S_Missions", "Leave") end)
				task.wait(1)
			else
				pcall(function() getRemote:InvokeServer("S_Missions", "Start") end)
				task.wait(5)
			end
		else
			local difficulties = {"Aberrant", "Severe", "Hard"}
			for _, diff in ipairs(difficulties) do
				if not IsToggled("SkinHunterToggle") then return end
				pcall(function()
					getRemote:InvokeServer("S_Missions", "Create", {
						Difficulty = diff,
						Type = "Raids",
						Name = targetRaidMapName,
						Objective = getgenv().KiraHub.Data.RaidObjectives[targetRaidMapName] or "Attack Titan"
					})
				end)
				task.wait(1)
				local created = false
				if activeMissions then
					for _, m in ipairs(activeMissions:GetChildren()) do
						if m:FindFirstChild("Leader") and m.Leader.Value == player.Name then
							created = true
							break
						end
					end
				end
				if created then break end
			end
		end
	else
		pcall(function() getgenv().KiraHub.UI.Labels.SkinHunter:SetText("Status: Scanning Boss") end)
		local titans = workspace:FindFirstChild("Titans")
		if not titans then
			task.wait(5)
			return
		end
		local waitStart = os.clock()
		local bossFound = nil
		while os.clock() - waitStart < 15 and IsToggled("SkinHunterToggle") do
			for _, t in ipairs(titans:GetChildren()) do
				if t.Name == bossName then
					bossFound = t
					break
				end
			end
			if bossFound then break end
			task.wait(1)
		end
		if not IsToggled("SkinHunterToggle") then return end
		if bossFound then
			local skinAttr = bossFound:GetAttribute("Skin")
			local fake = bossFound:FindFirstChild("Fake")
			local hair = fake and fake:FindFirstChild("Hair")
			local head = fake and fake:FindFirstChild("Head")
			local detectedSkin = skinAttr or (hair and hair.Name) or (head and head.Name) or "Standard"
			-- FIX: exact match first, fallback to lowercase contains
			local matchFound = tostring(detectedSkin):lower() == cleanSkinName:lower()
				or string.find(string.lower(tostring(detectedSkin)), string.lower(cleanSkinName), 1, true) ~= nil
			if matchFound then
				pcall(function() getgenv().KiraHub.UI.Labels.SkinHunter:SetText("Status: TARGET FOUND!") end)
				SetToggle("SkinHunterToggle", false)
				if IsToggled("ToggleSkinHunterWebhook") and not getgenv().KiraHub.SkinAlreadyLogged[cleanSkinName] then
					getgenv().KiraHub.SkinAlreadyLogged[cleanSkinName] = true
					pcall(function() DispatchSkinHunter(cleanSkinName, bossFound.Name) end)
				end
				FireRewardWebhook("SkinHunter", {
					description = "**Target skin found!**",
					color = 14495578,
					fields = {
						{name = "Player", value = player.Name, inline = true},
						{name = "Skin", value = cleanSkinName, inline = true},
						{name = "Boss", value = bossFound.Name, inline = true},
					}
				})
				Library:Notify({Title = "⚜ Skin Hunter", Description = cleanSkinName .. " found on " .. bossFound.Name, Time = 10})
				return
			end
			pcall(function() getgenv().KiraHub.UI.Labels.SkinHunter:SetText("Status: Wrong Skin - Re-rolling") end)
			local delayTime = GetOption("RejoinSpeedSlider", 8)
			task.wait(delayTime)
			if IsToggled("SkinHunterToggle") then
				-- FIX: same-server teleport (no lobby queue)
				pcall(function()
					TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
				end)
			end
		else
			pcall(function() getgenv().KiraHub.UI.Labels.SkinHunter:SetText("Status: No Boss Found - Re-rolling") end)
			local delayTime = GetOption("RejoinSpeedSlider", 8)
			task.wait(delayTime)
			if IsToggled("SkinHunterToggle") then
				pcall(function()
					TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
				end)
			end
		end
	end
end

