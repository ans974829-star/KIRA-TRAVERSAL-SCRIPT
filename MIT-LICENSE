						targets[i] = v:match("^%s*(.-)%s*$")
					end
				end
				local raritySelected = Kira.Options.SelectFamilyRarity and Kira.Options.SelectFamilyRarity.Value
				if raritySelected then
					rarities = {}
					for rarityName, isEnabled in pairs(raritySelected) do
						if isEnabled then
							table.insert(rarities, string.lower(rarityName))
						end
					end
				end
				Kira.DoRoll(targets, rarities)
				task.wait(0.25)
			end
		end)
