Kira.AutoFarmClass.Start = function(self)
	if self._running then return end
	if Kira.IsLobby then return end
	self._running = true
	getgenv().AutoFarm = true
	Kira.MissionFarmStartTime = os.clock()
	getgenv()._springVelocity = Vector3.new(0, 0, 0)

	task.spawn(function()
		while self._running do
			local char = Kira.Player.Character
			if char then
				local hrp = char:FindFirstChild("HumanoidRootPart")
				if hrp then hrp.AssemblyAngularVelocity = Kira.V3Zero end
			end
			task.wait()
		end
	end)

	task.spawn(function()
		Kira.UpdateStatus("Waiting for mission...")

		local function isWavesMode()
			return workspace:FindFirstChild("Waves") ~= nil
		end

		local function checkReady()
			local isWaves = isWavesMode()
			local char = Kira.Player.Character
			local playerReady = char and (
				char:GetAttribute("Shifter")
				or (char:FindFirstChild("Main") and char.Main:FindFirstChild("W"))
			)
			if isWaves then return playerReady and workspace:FindFirstChild("Titans") ~= nil end
			local mapReady = workspace:FindFirstChild("Unclimbable") ~= nil
			local titans = workspace:FindFirstChild("Titans")
			local titansReady = false
			if titans then
				for _, v in ipairs(titans:GetChildren()) do
					if v:FindFirstChild("Fake") and v.Fake:FindFirstChild("Head") and v.Fake.Head:FindFirstChild("Header") then
						titansReady = true
						break
					end
				end
			end
			return playerReady and mapReady and titansReady
		end

		local waitStart = os.clock()
		while self._running and not checkReady() do
			if os.clock() - waitStart > 10 then waitStart = os.clock() end
			task.wait(1)
		end
		if not self._running then return end

		if getgenv().WaitBeforeFarming and getgenv().WaitBeforeFarmingSecs > 0 then
			Kira.UpdateStatus("Waiting " .. tostring(getgenv().WaitBeforeFarmingSecs) .. "s before farming...")
			task.wait(getgenv().WaitBeforeFarmingSecs)
		end
		if not self._running then return end

		if getgenv().AntiDetectionWait then
			Kira.UpdateStatus("Stealth Anti-Detection delay active...")
			task.wait(5)
		end
		if not self._running then return end

		Kira.UpdateStatus("Farming")

		local titansFolder = workspace:FindFirstChild("Titans")
		local lastAttack = 0
		local currentChar, root = nil, nil
		local attackTitanSpawnTime = nil

		local function updateCharState()
			local char = Kira.Player.Character
			if not char then return false end
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if not hrp then return false end
			if char ~= currentChar then
				currentChar = char
				root = hrp
			end
			return true
		end

		local validNapes = {}
		local nextTitanCacheUpdate = 0
		local nextObjectiveCacheUpdate = 0
		local cachedObjectivePart = nil
		local masteryComboIndex = 1
		local lastMasteryPunch = 0

		while self._running do
			local wavesMode = workspace:FindFirstChild("Waves") ~= nil

			if getgenv().EmergencyStop then
				Kira.UpdateStatus("Paused - Emergency Stop")
				task.wait(0.1)
				continue
			end

			if getgenv().AutoFailsafe and Kira.MissionFarmStartTime then
				local elapsed = os.clock() - Kira.MissionFarmStartTime
				local limitSecs = (getgenv().FailsafeMinutes or 15) * 60
				if elapsed >= limitSecs then
					self:Stop()
					pcall(function()
						Kira.GetRemote:InvokeServer("Functions", "Teleport", "Lobby")
					end)
					task.wait(0.5)
					pcall(function()
						Kira.Services.TeleportService:Teleport(Kira.LobbyId, Kira.Player)
					end)
					break
				end
			end

			if Kira.Player:GetAttribute("Cutscene") then
				task.wait(0.05)
				continue
			end

			if not wavesMode and not Kira.CheckMission() then
				Kira.UpdateStatus("Waiting for mission...")
				task.wait(1)
				continue
			end

			local slotIndex = Kira.Player:GetAttribute("Slot")
			local slotData = slotIndex and Kira.MapData and Kira.MapData.Slots and Kira.MapData.Slots[slotIndex]

			if not wavesMode and not slotData then
				Kira.UpdateStatus("Waiting for data...")
				task.wait(1)
				continue
			end

			if getgenv().DieAtStreak then
				local streak = Kira.Player:GetAttribute("Streak") or 0
				if streak >= (getgenv().DieAtStreakCount or 10000) then
					local char = Kira.Player.Character
					if char then
						local hum = char:FindFirstChild("Humanoid")
						if hum then hum.Health = 0 end
					end
				end
			end

			local isBlades = true
			if slotData then
				isBlades = slotData.Weapon == "Blades"
			else
				local wt = Kira.GetWeaponType()
				isBlades = wt ~= "Spears"
			end
			getgenv().AutoFarmConfig.AttackCooldown = isBlades and 0.15 or 1

			local playerCount = workspace:GetAttribute("Player_Count") or #Kira.Services.Players:GetPlayers()
			if getgenv().SoloOnly and playerCount > 1 then
				self:Stop()
				pcall(function()
					Kira.GetRemote:InvokeServer("Functions", "Teleport", "Lobby")
				end)
				task.wait(0.5)
				Kira.Services.TeleportService:Teleport(Kira.LobbyId, Kira.Player)
				break
			end

			if not updateCharState() then
				task.wait(0.05)
				continue
			end
			titansFolder = workspace:FindFirstChild("Titans") or titansFolder

			local ws_ObjectiveFolder = workspace:FindFirstChild("Unclimbable") and workspace.Unclimbable:FindFirstChild("Objective")
			local rs_ObjectiveFolder = Kira.Services.ReplicatedStorage:FindFirstChild("Objectives")
			local mapType = wavesMode and "Waves" or (workspace:GetAttribute("Type") or (Kira.MapData and Kira.MapData.Map and Kira.MapData.Map.Type))

			local isArmoredRaid = not wavesMode and ws_ObjectiveFolder and ws_ObjectiveFolder:FindFirstChild("Armored_Boss")
			local isFemaleRaid = not wavesMode and rs_ObjectiveFolder and rs_ObjectiveFolder:FindFirstChild("Defeat_Annie")
			local femaleExists = not wavesMode and ws_ObjectiveFolder and ws_ObjectiveFolder:FindFirstChild("Female_Boss")
			local attackExists = not wavesMode and ws_ObjectiveFolder and ws_ObjectiveFolder:FindFirstChild("Attack_Boss")
			local armoredTitan = not wavesMode and titansFolder and titansFolder:FindFirstChild("Armored_Titan")
			local hasReinerObjective = armoredTitan and armoredTitan:GetAttribute("State")
			local isColossalRaid = not wavesMode and (
				(rs_ObjectiveFolder and rs_ObjectiveFolder:FindFirstChild("Defeat_Bertholdt"))
				or (ws_ObjectiveFolder and ws_ObjectiveFolder:FindFirstChild("Colossal_Boss"))
			)
			local isDefendEren = not wavesMode and rs_ObjectiveFolder and rs_ObjectiveFolder:FindFirstChild("Defend_Eren")
			local isDefendBoats = not wavesMode and rs_ObjectiveFolder and rs_ObjectiveFolder:FindFirstChild("Defend_Boats")
			local isRaidDefensePhase = (isDefendEren or isDefendBoats) and getgenv().AutoFarmRaids

			if not wavesMode and isFemaleRaid and not femaleExists and not attackExists then
				task.wait(0.05)
				continue
			end

			if not wavesMode and isColossalRaid then
				local stallObjective = rs_ObjectiveFolder and rs_ObjectiveFolder:FindFirstChild("Stall_Colossal_Titan")
				local stallDone = stallObjective and stallObjective.Value >= (stallObjective:GetAttribute("Requirement") or 1)
				if not stallDone then
					Kira.UpdateStatus("Colossal Raid - Phase 1: Stalling...")
					local walls = workspace:FindFirstChild("Climbable") and workspace.Climbable:FindFirstChild("Walls")
					local cannonModel = nil
					if walls then
						cannonModel = walls:FindFirstChild("Wall") and walls.Wall:FindFirstChild("Cannons") and walls.Wall.Cannons:FindFirstChild("1")
						if not cannonModel then
							for _, wall in ipairs(walls:GetChildren()) do
								local c = wall:FindFirstChild("Cannons") and wall.Cannons:FindFirstChild("1")
								if c then cannonModel = c break end
							end
						end
					end
					if cannonModel and not getgenv()._colossalCannonRunning then
						getgenv()._colossalCannonRunning = true
						task.spawn(function()
							local function getLiveNapePos()
								local tf = workspace:FindFirstChild("Titans")
								local ct = tf and tf:FindFirstChild("Colossal_Titan")
								if not ct then return nil end
								local hit = ct:FindFirstChild("Hitboxes") and ct.Hitboxes:FindFirstChild("Hit")
								if hit and hit:FindFirstChild("Nape") then return hit.Nape.Position end
								local fake = ct:FindFirstChild("Fake")
								local head = fake and fake:FindFirstChild("Head")
								return head and head.Position or nil
							end
							local function isStallComplete()
								local so = Kira.Services.ReplicatedStorage:FindFirstChild("Objectives") and Kira.Services.ReplicatedStorage.Objectives:FindFirstChild("Stall_Colossal_Titan")
								return so and so.Value >= (so:GetAttribute("Requirement") or 1)
							end
							local impactConn = Kira.PostRemote.OnClientEvent:Connect(function(a1, a2, cannonObj)
								if a1 ~= "Skills" or a2 ~= "Impact" then return end
								if not getgenv()._colossalCannonRunning then return end
								local ref = cannonObj or workspace:FindFirstChild("Cannon")
								if not ref then return end
								for i = 1, 30 do
									local napePos = getLiveNapePos()
									if napePos then
										pcall(function()
											Kira.PostRemote:FireServer("S_Skills", "Impact", ref, napePos)
										end)
									end
								end
							end)
							while self._running and not isStallComplete() do
								pcall(function()
									Kira.GetRemote:InvokeServer("Cannon", "State", cannonModel, true)
								end)
								task.wait(0.3)
								for shootAttempt = 1, 3 do
									local shootOk = pcall(function()
										Kira.GetRemote:InvokeServer("Cannon", "Shoot", {BarrelWood = 40, Base = 0})
									end)
									if shootOk then break end
									task.wait(0.1)
								end
								task.wait(1.8)
							end
							impactConn:Disconnect()
							pcall(function()
								Kira.GetRemote:InvokeServer("Cannon", "State", cannonModel, false)
							end)
							getgenv()._colossalCannonRunning = false
							Kira.UpdateStatus("Colossal Raid - Phase 1 Complete!")
						end)
					end
				else
					getgenv()._colossalCannonRunning = false
					if not getgenv()._colossalPhase2Running then
						getgenv()._colossalPhase2Running = true
						task.spawn(function()
							Kira.UpdateStatus("Colossal Raid - Phase 2: Finish + Defend Eren!")
							while self._running do
								local tf = workspace:FindFirstChild("Titans")
								local ct = tf and tf:FindFirstChild("Colossal_Titan")
								if not ct then task.wait(0.5) continue end
								local hit = ct:FindFirstChild("Hitboxes") and ct.Hitboxes:FindFirstChild("Hit")
								if not hit then task.wait(0.5) continue end
								local napePart = hit:FindFirstChild("Nape")
								if not napePart then task.wait(0.5) continue end
								local napePos = napePart.Position + Vector3.new(0, 4, 0)
								local weaponUsed = Kira.GetWeaponType()
								if weaponUsed == "Spears" then
									for i = 1, 15 do
										pcall(function()
											Kira.PostRemote:FireServer("Spears", "S_Explode", napePos)
										end)
									end
								else
									pcall(function()
										Kira.PostRemote:FireServer("Attacks", "Slash", true)
									end)
								end
								local bossHits = getgenv().BladeBossHitsCount or 35
								local hitsPerTick = 5
								for batch = 1, math.ceil(bossHits / hitsPerTick) do
									for j = 1, math.min(hitsPerTick, bossHits - (batch - 1) * hitsPerTick) do
										pcall(function()
											Kira.PostRemote:FireServer("Hitboxes", "Register", napePart, math.random(625, 850))
										end)
									end
									task.wait()
								end
								task.wait(0.05)
							end
							getgenv()._colossalPhase2Running = false
						end)
						task.spawn(function()
							while getgenv()._colossalPhase2Running do
								task.wait(0.5)
								local rsObj = Kira.Services.ReplicatedStorage:FindFirstChild("Objectives")
								local defendEren = rsObj and rsObj:FindFirstChild("Defend_Eren")
								local defendBoats = rsObj and rsObj:FindFirstChild("Defend_Boats")
								if not defendEren and not defendBoats then continue end
								local tf = workspace:FindFirstChild("Titans")
								if not tf then continue end
								local erenModel = workspace:FindFirstChild("NPC_Eren_Titan") or workspace:FindFirstChild("Eren_Titan") or workspace:FindFirstChild("Eren")
								local erenPos = nil
								if erenModel then
									local ep = erenModel.PrimaryPart or erenModel:FindFirstChildWhichIsA("BasePart")
									if ep then erenPos = ep.Position end
								end
								for _, t in ipairs(tf:GetChildren()) do
									pcall(function()
										if Kira.BossNames[t.Name] then return end
										if t:GetAttribute("Dead") or t:GetAttribute("Killed") then return end
										local hum = t:FindFirstChildOfClass("Humanoid")
										if not hum or hum.Health <= 0 then return end
										local tHit = t:FindFirstChild("Hitboxes") and t.Hitboxes:FindFirstChild("Hit")
										local tNape = tHit and tHit:FindFirstChild("Nape")
										if not tNape then return end
										local shouldTarget = false
										if erenPos then
											local tp = t.PrimaryPart or t:FindFirstChildWhichIsA("BasePart")
											local dist = tp and (tp.Position - erenPos).Magnitude or 999
											if dist < 200 then shouldTarget = true end
										else
											shouldTarget = true
										end
										if shouldTarget then
											Kira.PostRemote:FireServer("Attacks", "Slash", true)
											for k = 1, getgenv().BladeBossHitsCount or 35 do
												Kira.PostRemote:FireServer("Hitboxes", "Register", tNape, math.random(625, 850))
											end
										end
									end)
								end
							end
						end)
					end
				end
			end

			if math.fmod(os.clock(), 0.5) < 0.05 then
				pcall(function()
					if root then root.CanCollide = false end
				end)
			end

			local now = os.clock()
			local isShifted = currentChar and currentChar:GetAttribute("Shifter") or false

			if getgenv().MasteryFarmConfig.Enabled then
				local shiftReady = Kira.Player:GetAttribute("Bar") and Kira.Player:GetAttribute("Bar") == 100
				if not isShifted and shiftReady then
					repeat
						pcall(function()
							Kira.GetRemote:InvokeServer("S_Skills", "Usage", "999", false)
						end)
						task.wait(1)
					until not self._running or (Kira.Player.Character and Kira.Player.Character:GetAttribute("Shifter"))
					continue
				end
			end

			if now >= nextTitanCacheUpdate then
				nextTitanCacheUpdate = now + 0.1
				table.clear(validNapes)
				if titansFolder then
					for _, v in ipairs(titansFolder:GetChildren()) do
						if v:GetAttribute("Killed") then continue end
						local hit = v:FindFirstChild("Hitboxes") and v.Hitboxes:FindFirstChild("Hit")
						if hit then
							local fake = v:FindFirstChild("Fake")
							if fake and fake:FindFirstChild("Collision") and not fake.Collision.CanCollide then continue end
							local nape = hit:FindFirstChild("Nape")
							if nape then
								if getgenv().AutoIceburstHunt then
									local isIceburst = v:GetAttribute("Type") == "Iceburst" or v.Name:find("Iceburst")
									if isIceburst then
										table.insert(validNapes, 1, nape)
									else
										table.insert(validNapes, nape)
									end
								else
									table.insert(validNapes, nape)
								end
							end
						end
					end
				end
			end

			if #validNapes == 0 then
				if root then root.AssemblyLinearVelocity = Kira.V3Zero end
				getgenv()._springVelocity = Kira.V3Zero
				task.wait(0.05)
				continue
			end

			local rootPos = root.Position
			local referencePos = rootPos
			local objectiveFound = false

			if not wavesMode and now >= nextObjectiveCacheUpdate then
				nextObjectiveCacheUpdate = now + 1
				cachedObjectivePart = nil
				if ws_ObjectiveFolder then
					for _, desc in ipairs(ws_ObjectiveFolder:GetDescendants()) do
						if desc:IsA("BillboardGui") and desc.Parent and desc.Parent:IsA("BasePart") then
							cachedObjectivePart = desc.Parent
							break
						end
					end
				end
			end

			if not wavesMode and cachedObjectivePart and cachedObjectivePart.Parent then
				referencePos = cachedObjectivePart.Position
				objectiveFound = true
			end

			if isRaidDefensePhase and objectiveFound then
				referencePos = cachedObjectivePart.Position
			end

			local useRangeLimit = not wavesMode and objectiveFound and isArmoredRaid and not hasReinerObjective
			local closestDist, closestNape = math.huge, nil
			local closestIsBoss = false
			local bossDist, bossHitPoint = math.huge, nil
			local attackTitanFound = false
			local highestZ = -math.huge
			local isStall = not wavesMode and Kira.MapData and Kira.MapData.Map and Kira.MapData.Map.Objective == "Stall"
			local bossIsRoaring = false

			for i = 1, #validNapes do
				local nape = validNapes[i]
				if not nape or not nape.Parent then continue end
				local titanModel = nape.Parent.Parent.Parent
				local fake = titanModel:FindFirstChild("Fake")
				if (fake and fake:FindFirstChild("Collision") and not fake.Collision.CanCollide)
					or titanModel:GetAttribute("Dead") then continue end
				local tName = titanModel.Name
				local isBoss = Kira.BossNames[tName]
				if not wavesMode and isArmoredRaid and not hasReinerObjective and tName == "Armored_Titan" then continue end
				if not wavesMode and isColossalRaid and tName == "Colossal_Titan" then continue end
				if not wavesMode and isBoss and not titanModel:GetAttribute("State") then continue end
				local isRoaring = not wavesMode and isBoss and (
					titanModel:GetAttribute("Attack") == "Roar"
					or titanModel:GetAttribute("Attack") == "Berserk_Mode"
				)
				if tName == "Attack_Titan" then attackTitanFound = true end
				local dx = referencePos.X - nape.Position.X
				local dz = referencePos.Z - nape.Position.Z
				local d = dx * dx + dz * dz
				local adjustedDist = d
				if getgenv()._currentTargetNape == nape then adjustedDist = adjustedDist - 15000 end
				if useRangeLimit and d > 90000 then continue end
				if not wavesMode and isBoss then
					local hitPart = (titanModel:FindFirstChild("Marker") and titanModel.Marker.Adornee) or titanModel.Hitboxes.Hit.Nape
					if hitPart and adjustedDist < bossDist then
						bossDist = adjustedDist
						bossHitPoint = hitPart
						bossIsRoaring = isRoaring
					end
				end
				if isStall then
					if nape.Position.Z > highestZ then
						highestZ = nape.Position.Z
						closestNape = nape
					end
				elseif adjustedDist < closestDist then
					closestDist = adjustedDist
					closestNape = nape
					closestIsBoss = isBoss
				end
			end

			local targetPart, targetIsRoaring = nil, false

			if wavesMode then
				targetPart = closestNape
			elseif isRaidDefensePhase then
				targetPart = closestNape or bossHitPoint
				targetIsRoaring = (targetPart == bossHitPoint) and bossIsRoaring or false
			else
				local prio = getgenv().RaidPriority or "Boss First"
				if prio == "Boss First" then
					targetPart = bossHitPoint or closestNape
					targetIsRoaring = (targetPart == bossHitPoint) and bossIsRoaring or false
				elseif prio == "Adds First" then
					targetPart = closestNape or bossHitPoint
					targetIsRoaring = (targetPart == bossHitPoint) and bossIsRoaring or false
				elseif prio == "Mixed" then
					if math.random(1, 3) == 1 and bossHitPoint then
						targetPart = bossHitPoint
						targetIsRoaring = bossIsRoaring
					else
						targetPart = closestNape or bossHitPoint
						targetIsRoaring = (targetPart == bossHitPoint) and bossIsRoaring or false
					end
				else
					targetPart = closestNape
					if targetPart == bossHitPoint then targetIsRoaring = bossIsRoaring end
				end
			end

			if useRangeLimit and closestNape then
				targetPart = closestNape
				targetIsRoaring = false
			end

			if not getgenv()._missionStartTime then getgenv()._missionStartTime = os.clock() end

			if not wavesMode and targetPart and #validNapes == 1 and mapType == "Missions" then
				local elapsed = os.clock() - getgenv()._missionStartTime
				local requiredWait = getgenv().LastTitanWait and getgenv().LastTitanWaitSecs or 10
				if elapsed < requiredWait then
					Kira.UpdateStatus("Waiting... " .. tostring(math.floor(requiredWait - elapsed)) .. "s left")
					targetPart = nil
				end
			end

			getgenv()._currentTargetNape = targetPart
			if attackTitanFound then
				attackTitanSpawnTime = attackTitanSpawnTime or now
			else
				attackTitanSpawnTime = nil
			end
			local attackTitanReady = not attackTitanFound or (attackTitanSpawnTime and (now - attackTitanSpawnTime) >= 5)

			if targetPart then
				local statusMsg
				if closestIsBoss then statusMsg = "Attacking Boss..."
				elseif isRaidDefensePhase then statusMsg = "Defending Objective..."
				elseif wavesMode then statusMsg = "Farming Waves..."
				else statusMsg = "Farming Titans..." end
				Kira.UpdateStatus(statusMsg)

				local currentTitanModel = targetPart
				while currentTitanModel and currentTitanModel.Parent ~= titansFolder do
					currentTitanModel = currentTitanModel.Parent
				end

				if isShifted then
					local targetHRP = currentTitanModel and currentTitanModel:FindFirstChild("HumanoidRootPart")
					local targetCFrame = targetHRP and targetHRP.CFrame or targetPart.CFrame
					root.AssemblyLinearVelocity = Kira.V3Zero
					root.CFrame = targetCFrame * CFrame.new(0, 0, 80)
					local mode = getgenv().MasteryFarmConfig.Mode
					local doPunch = mode == "Punching" or mode == "Both"
					local doSkills = mode == "Skill Usage" or mode == "Both"
					if not targetIsRoaring then
						if doPunch and (now - lastMasteryPunch) >= 1 then
							lastMasteryPunch = now
							Kira.PostRemote:FireServer("Attacks", "Slash", true)
							Kira.PostRemote:FireServer("Hitboxes", "Register", targetPart, nil, nil, masteryComboIndex)
							masteryComboIndex = masteryComboIndex + 1
							if masteryComboIndex > 4 then masteryComboIndex = 1 end
						end
						if doSkills and slotData and slotData.Skills and slotData.Skills.Shifter and not getgenv().ShifterSkillsRunning then
							getgenv().ShifterSkillsRunning = true
							task.spawn(function()
								for _, skillId in ipairs(slotData.Skills.Shifter) do
									local idNum = tonumber(skillId)
									if idNum and idNum ~= 200 and idNum ~= 300 and idNum ~= 400
										and idNum ~= 210 and idNum ~= 211 and idNum ~= 306
										and idNum ~= 308 and idNum ~= 402 and idNum ~= 403 and idNum ~= 407
									then
										pcall(function()
											Kira.GetRemote:InvokeServer("S_Skills", "Usage", tostring(skillId), false)
										end)
									end
									task.wait(1)
								end
								getgenv().ShifterSkillsRunning = false
							end)
						end
					end
					task.wait(0.05)
					continue
				end

				local titanHRP = currentTitanModel and currentTitanModel:FindFirstChild("HumanoidRootPart")
				local targetHeightPos
				if titanHRP then
					targetHeightPos = (titanHRP.CFrame * CFrame.new(0, getgenv().AutoFarmConfig.HeightOffset, 30)).Position
				else
					targetHeightPos = targetPart.Position + Vector3.new(0, getgenv().AutoFarmConfig.HeightOffset, 0)
				end

				local moveMode = getgenv().AutoFarmConfig.MovementMode
				if moveMode == "Hover" then
					local dir = targetHeightPos - rootPos
					if dir.Magnitude > 1 then
						root.AssemblyLinearVelocity = dir.Unit * getgenv().AutoFarmConfig.MoveSpeed
					else
						root.AssemblyLinearVelocity = Kira.V3Zero
					end
				elseif moveMode == "Teleport" then
					root.AssemblyLinearVelocity = Kira.V3Zero
					root.CFrame = CFrame.new(targetHeightPos)
				elseif moveMode == "Tween" then
					pcall(function()
						root.AssemblyLinearVelocity = Kira.V3Zero
						local tweenTime = (targetHeightPos - root.Position).Magnitude / (getgenv().AutoFarmConfig.MoveSpeed or 400)
						local tween = Kira.Services.TweenService:Create(root, TweenInfo.new(tweenTime, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetHeightPos)})
						tween:Play()
						tween.Completed:Wait()
					end)
				elseif moveMode == "Rubber Band" then
					local springK = getgenv().SpringK or 80
					local damping = getgenv().SpringDamping or 12
					local maxVelocity = 350
					local dt = 1 / 60
					local pos = root.Position
					local delta = targetHeightPos - pos
					if delta.Magnitude < 1.5 then
						root.CFrame = CFrame.new(targetHeightPos)
						root.AssemblyLinearVelocity = Kira.V3Zero
						root.AssemblyAngularVelocity = Kira.V3Zero
						getgenv()._springVelocity = Kira.V3Zero
					else
						local sv = getgenv()._springVelocity
						local flatDelta = Vector3.new(delta.X, 0, delta.Z)
						local vertDelta = Vector3.new(0, delta.Y, 0)
						local flatAccel = flatDelta * springK - Vector3.new(sv.X, 0, sv.Z) * damping
						local vertAccel = vertDelta * (springK * 1.5) - Vector3.new(0, sv.Y, 0) * (damping * 2)
						sv = sv + (flatAccel + vertAccel) * dt
						if sv.Magnitude > maxVelocity then sv = sv.Unit * maxVelocity end
						local nextPos = pos + sv * dt
						local minY = targetHeightPos.Y - 10
						local maxY = targetHeightPos.Y + 20
						if nextPos.Y < minY then
							nextPos = Vector3.new(nextPos.X, minY, nextPos.Z)
							if sv.Y < 0 then sv = Vector3.new(sv.X, math.abs(sv.Y) * 0.2, sv.Z) end
						end
						if nextPos.Y > maxY then
							nextPos = Vector3.new(nextPos.X, maxY, nextPos.Z)
							if sv.Y > 0 then sv = Vector3.new(sv.X, -math.abs(sv.Y) * 0.2, sv.Z) end
						end
						local hFlat = Vector3.new(nextPos.X, 0, nextPos.Z)
						local tFlat = Vector3.new(targetHeightPos.X, 0, targetHeightPos.Z)
						if (hFlat - tFlat).Magnitude > 35 then
							local flatDir = (hFlat - tFlat).Unit
							local clamped = tFlat + flatDir * 35
							nextPos = Vector3.new(clamped.X, nextPos.Y, clamped.Z)
							sv = Vector3.new(sv.X * 0.4, sv.Y, sv.Z * 0.4)
						end
						getgenv()._springVelocity = sv
						root.CFrame = CFrame.new(nextPos) * (root.CFrame - root.CFrame.Position)
						root.AssemblyLinearVelocity = sv
						root.AssemblyAngularVelocity = Kira.V3Zero
					end
				end

				if not attackTitanReady then
					task.wait(0.05)
					continue
				end

				local dx = root.Position.X - targetPart.Position.X
				local dz = root.Position.Z - targetPart.Position.Z
				local AttackRangeSq = getgenv().AutoFarmConfig.AttackRange * getgenv().AutoFarmConfig.AttackRange

				if not targetIsRoaring
					and (dx * dx + dz * dz) <= AttackRangeSq
					and (now - lastAttack) >= getgenv().AutoFarmConfig.AttackCooldown
				then
					lastAttack = now

					local hitTargets = {targetPart}
					if getgenv().MultiHit then
						local count = 1
						for i = 1, #validNapes do
							if count >= (getgenv().MultiHitCount or 3) then break end
							local n = validNapes[i]
							if n ~= targetPart and n and n.Parent then
								local isDead = false
								pcall(function()
									isDead = n.Parent.Parent.Parent:GetAttribute("Dead") == true
								end)
								if not isDead then
									table.insert(hitTargets, n)
									count = count + 1
								end
							end
						end
					end

					if getgenv().SkillCooldownAction then
						Kira.CancelAnimations()
					end

					if isBlades then
						Kira.PostRemote:FireServer("Attacks", "Slash", true)
						local thisBoss = Kira.CheckIsBossTarget(targetPart)
						local bladeLoops = thisBoss and (getgenv().BladeBossHitsCount or 35) or 1
						for j = 1, bladeLoops do
							for _, nape in ipairs(hitTargets) do
								pcall(function()
									Kira.PostRemote:FireServer("Hitboxes", "Register", nape, math.random(625, 850))
								end)
							end
						end
					else
						local spearsLabel = nil
						pcall(function()
							spearsLabel = Kira.PlayerGui.Interface.HUD.Main.Top["7"].Spears.Spears
						end)
						if spearsLabel then
							local currentAmmo, maxAmmo = string.match(spearsLabel.Text, "(%d+)%s*/%s*(%d+)")
							currentAmmo = tonumber(currentAmmo)
							maxAmmo = tonumber(maxAmmo)
							if (currentAmmo and currentAmmo > 0) or getgenv().InfiniteSpears then
								local ammoToUse = getgenv().InfiniteSpears and maxAmmo or currentAmmo
								task.spawn(function()
									local function getAmmo()
										return tonumber(string.match(spearsLabel.Text, "(%d+)"))
									end
									local beforeAmmo = getAmmo()
									Kira.GetRemote:InvokeServer("Spears", "S_Fire", tostring(ammoToUse))
									local afterAmmo = getAmmo()
									if afterAmmo and beforeAmmo and afterAmmo == beforeAmmo and not getgenv().InfiniteSpears then
										for j = maxAmmo, 1, -1 do
											Kira.GetRemote:InvokeServer("Spears", "S_Fire", tostring(j))
											local newAmmo = getAmmo()
											if newAmmo and beforeAmmo and newAmmo < beforeAmmo then break end
										end
									end
									local isBoss = Kira.CheckIsBossTarget(targetPart)
									local loops = isBoss and 40 or 1
									for j = 1, loops do
										for _, nape in ipairs(hitTargets) do
											pcall(function()
												Kira.PostRemote:FireServer("Spears", "S_Explode", nape.Position)
											end)
										end
									end
								end)
							end
						end
					end
				end
			else
				if root then root.AssemblyLinearVelocity = Kira.V3Zero end
				getgenv()._springVelocity = Kira.V3Zero
			end

			task.wait(0.05)
		end
	end)
end

