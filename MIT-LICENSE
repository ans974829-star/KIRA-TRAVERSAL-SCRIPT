local function HandleTitanSkinMatchmaking()
	if not IsToggled("SkinHunterToggle") then
		pcall(function() getgenv().KiraHub.UI.Labels.SkinHunter:SetText("Status: Idle") end)
		return
	end
	local targetSkinFriendlyName = GetOption("TargetSkinDropdown", "Onikiri Skin")
	local cleanSkinName = string.gsub(targetSkinFriendlyName, " Skin", "")
	local targetRaidMapName = getgenv().KiraHub.Data.SkinToRaidMap[cleanSkinName]
	local bossName = getgenv().KiraHub.Data.SkinToBoss[cleanSkinName]
	if not targetRaidMapName or not bossName then return end
	if game.PlaceId == LOBBY_ID then
		pcall(function() getgenv().KiraHub.UI.Labels.SkinHunter:SetText("Status: Queueing " .. targetRaidMapName) end)
		local activeMissions = ReplicatedStorage:FindFirstChild("Missions")
		local registeredMission = nil
		if activeMissions then
			for _, m in ipairs(activeMissions:GetChildren()) do
				if m:FindFirstChild("Leader") and m.Leader.Value == player.Name then
					registeredMission = m
					break
				end
			end
		end
		if registeredMission then
			local mapNameMatched = registeredMission.Name == targetRaidMapName
			if not mapNameMatched then
				pcall(function() getRemote:InvokeServer("S_Missions", "Leave") end)
				task.wait(1)
			else
				pcall(function() getRemote:InvokeServer("S_Missions", "Start") end)
				task.wait(5)
			end
		else
			pcall(function()
				getRemote:InvokeServer("S_Missions", "Create", {
					Difficulty = "Aberrant",
					Type = "Raids",
					Name = targetRaidMapName,
					Objective = getgenv().KiraHub.Data.RaidObjectives[targetRaidMapName]
				})
			end)
			task.wait(0.6)
		end
	else
		pcall(function() getgenv().KiraHub.UI.Labels.SkinHunter:SetText("Status: Checking Boss Skin") end)
		local titans = workspace:FindFirstChild("Titans")
		if titans then
			local bossFound = nil
			for _, t in ipairs(titans:GetChildren()) do
				if t.Name == bossName then
					bossFound = t
					break
				end
			end
			if bossFound then
				local skinAttribute = bossFound:GetAttribute("Skin")
				local activeHair = bossFound:FindFirstChild("Fake") and bossFound.Fake:FindFirstChild("Hair")
				local detectedSkinName = skinAttribute or (activeHair and activeHair.Name) or "Standard"
				if string.find(string.lower(detectedSkinName), string.lower(cleanSkinName)) then
					pcall(function() getgenv().KiraHub.UI.Labels.SkinHunter:SetText("Status: Target Skin Found!") end)
					pcall(function() Toggles.SkinHunterToggle:SetValue(false) end)
					if IsToggled("ToggleSkinHunterWebhook") and not getgenv().KiraHub.SkinAlreadyLogged[detectedSkinName] then
						getgenv().KiraHub.SkinAlreadyLogged[detectedSkinName] = true
						DispatchSkinHunterWebhook(detectedSkinName, bossFound.Name)
					end
					Library:Notify({Title = "Skin Hunter", Description = "Successfully found " .. cleanSkinName .. " on " .. bossFound.Name, Time = 10})
				else
					pcall(function() getgenv().KiraHub.UI.Labels.SkinHunter:SetText("Status: Wrong Skin (" .. detectedSkinName .. ") - Rejoining") end)
					local delayTime = GetOption("RejoinSpeedSlider", 10)
					task.wait(delayTime)
					if IsToggled("SkinHunterToggle") then
						pcall(function() getRemote:InvokeServer("Functions", "Teleport", "Lobby") end)
						task.wait(0.5)
						TeleportService:Teleport(LOBBY_ID, player)
					end
				end
			end
		end
	end
end

