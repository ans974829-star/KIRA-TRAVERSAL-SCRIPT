			if sd then
				if sd.Currency then
					for i, v in pairs(sd.Currency) do
						if i == "Gems" or i == "Gold" then totals[i] = v end
					end
				end
				if sd.Progression then
					for i, v in pairs(sd.Progression) do
						if i == "Prestige" or i == "Level" or i == "Streak" then totals[i] = v end
					end
				end
			end
		end)

		local banStatus = GetBanStatus()
		local hasSpecial = special and next(special) ~= nil
		local displayName = IsToggled("RewardsShowUsernameToggle") and player.Name or "Anonymous"
		local exec = "Unknown"
		pcall(function() exec = identifyexecutor and identifyexecutor() or "Unknown" end)
		local missionMap = (mapData and mapData.Map and mapData.Map.Name) or "Unknown"
		local missionDiff = (mapData and mapData.Map and mapData.Map.Difficulty) or "Unknown"
		local missionObj = (mapData and mapData.Map and mapData.Map.Objective) or "Unknown"
		local missionType = (mapData and mapData.Map and mapData.Map.Type) or "Missions"

		PostWebhook(webhook, {
			content = hasSpecial and "@everyone ◤ MYTHICAL DROP ◢" or nil,
			embeds = {{
				title = "Kira Hub | Mission Completed",
				description = "**Mission:** " .. missionObj .. " [" .. missionDiff .. "]\n**Player:** " .. displayName,
				color = hasSpecial and 16711680 or 3066993,
