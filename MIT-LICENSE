local function BuildFeedbackTab(TabRef)
	local F_Box = TabRef:AddLeftGroupbox("Send Feedback", "message-circle")

	F_Box:AddDropdown("StarRatingDropdown", {
		Text = "Rating",
		Values = {"1 Star","2 Stars","3 Stars","4 Stars","5 Stars"},
		Default = "5 Stars",
		Multi = false
	})

	F_Box:AddInput("FeedbackInput", {
		Text = "Feedback",
		Default = "",
		Placeholder = "Enter your feedback..."
	})

	F_Box:AddToggle("FeedbackShowUsernameToggle", {
		Text = "Show my username",
		Default = false,
		Tooltip = "Otherwise sent as Anonymous"
	})

	getgenv().KiraHub.UI.Labels.FeedbackCooldown = F_Box:AddLabel("Cooldown: Ready")

	F_Box:AddButton({
		Text = "Submit Feedback",
		Func = function()
			local now = tick()
			local lastSent = getgenv().KiraHub.State.FeedbackCooldown or 0
			local elapsed = now - lastSent
			local cooldownDuration = 3600
			if elapsed < cooldownDuration then
				local remaining = math.ceil(cooldownDuration - elapsed)
				local mins = math.floor(remaining / 60)
				local secs = remaining % 60
				Library:Notify({
					Title = "Feedback Cooldown",
					Description = "Please wait " .. mins .. "m " .. secs .. "s",
					Time = 4
				})
				return
			end
			local text = Options.FeedbackInput and Options.FeedbackInput.Value or ""
			local starsRaw = Options.StarRatingDropdown and Options.StarRatingDropdown.Value or "5 Stars"
			local stars = tonumber(starsRaw:match("(%d)")) or 5
			if #text < 5 then
				Library:Notify({Title = "Feedback", Description = "Please write at least 5 characters", Time = 3})
				return
			end
			local starDisplay = string.rep("⭐", stars)
			local showUsername = Toggles.FeedbackShowUsernameToggle and Toggles.FeedbackShowUsernameToggle.Value
			local displayUser = showUsername and player.Name or "Anonymous [ privacy reasons ]"
			local feedbackWebhook = "https://discord.com/api/webhooks/1497872469498007623/4WiMiJdKVe-3fGD8HdQr2mzbcKImgHU8vjBe-w2JEIlvAqvNGpvLQDeecWbFms8_pIi-"
			local sent = PostWebhook(feedbackWebhook, {
				embeds = {{
					title = "Kira Hub x AoT:R | Feedback",
					description = "⭐ **Rating** - " .. starDisplay .. " (" .. stars .. " / 5)\n"
						.. "💬 **Feedback** - \"" .. text .. "\"\n"
						.. "👤 **Username** - " .. displayUser .. "\n"
						.. "📦 **Game** - Attack on Titan: Revolution\n"
						.. "📋 **Version** - Kira Hub v2.9",
					color = 13158600,
					footer = {text = "Kira Hub | Feedbacks"},
					timestamp = DateTime.now():ToIsoDate()
				}}
			})
			if sent then
				getgenv().KiraHub.State.FeedbackCooldown = now
				pcall(function() Options.FeedbackInput:SetValue("") end)
