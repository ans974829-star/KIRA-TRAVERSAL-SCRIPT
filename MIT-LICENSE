-- Boss Rejoin helper (Eclipse-style: leave current, rejoin specific boss raid)
Kira.BossRejoinMap = {
	Jotunn      = {Map = "Trost",       Objective = "Attack Titan",   Difficulty = "Aberrant"},
	Onikiri     = {Map = "Shiganshina", Objective = "Armored Titan",  Difficulty = "Aberrant"},
	["Deus Ex"] = {Map = "Stohess",     Objective = "Female Titan",   Difficulty = "Aberrant"},
}

Kira.RejoinBossRaid = function(bossKey)
	task.spawn(function()
		local config = Kira.BossRejoinMap[bossKey]
		if not config then return end
		-- Leave current mission if in one
		if Kira.AutoFarmClass._running then
			Kira.AutoFarmClass:Stop()
		end
		pcall(function()
			Kira.GetRemote:InvokeServer("S_Missions", "Leave")
		end)
		task.wait(0.5)
		-- Return to lobby if not already there
		if game.PlaceId ~= Kira.LobbyId then
			pcall(function()
				Kira.GetRemote:InvokeServer("Functions", "Teleport", "Lobby")
			end)
			task.wait(0.5)
			pcall(function()
				Kira.Services.TeleportService:Teleport(Kira.LobbyId, Kira.Player)
			end)
			task.wait(6)
		end
		-- Create and start the raid
		local created = false
		for _, diff in ipairs({config.Difficulty, "Severe", "Hard"}) do
			if created then break end
			pcall(function()
				Kira.GetRemote:InvokeServer("S_Missions", "Create", {
					Difficulty = diff,
					Type       = "Raids",
					Name       = config.Map,
					Objective  = config.Objective,
				})
			end)
			task.wait(0.8)
			for _, m in ipairs(Kira.Services.ReplicatedStorage.Missions:GetChildren()) do
				if m:FindFirstChild("Leader") and m.Leader.Value == Kira.Player.Name then
					created = true
					break
				end
			end
		end
		if created then
			task.wait(0.5)
			pcall(function()
				Kira.GetRemote:InvokeServer("S_Missions", "Start")
			end)
			Kira.LibraryInstance:Notify({
				Title       = "Boss Rejoin",
				Description = bossKey .. " raid started!",
				Time        = 3
			})
		else
			Kira.LibraryInstance:Notify({
				Title       = "Boss Rejoin",
				Description = "Failed to create " .. bossKey .. " raid.",
				Time        = 4
			})
		end
	end)
end

