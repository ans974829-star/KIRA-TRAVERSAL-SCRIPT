Kira.GetTSQuestStatus = function()
	local slot = Kira.Player:GetAttribute("Slot")
	local slotData = slot and Kira.MapData and Kira.MapData.Slots and Kira.MapData.Slots[slot]
	if slotData and type(slotData.Quests) == "table" and type(slotData.Quests.Spears) == "table" then
		return slotData.Quests.Spears
	end
	return nil
end

Kira.GetTSQuestProgress = function(tag)
	local questTable = Kira.GetTSQuestStatus()
	if not questTable then return 0, false, false end
	for _, v in pairs(questTable) do
		if type(v) == "table" and v.Tag == tag then
			return v.Current or 0, v.Rewarded == true, true
		end
	end
	return 0, false, false
end

Kira.GetTSInventoryPieceCount = function()
	local slot = Kira.Player:GetAttribute("Slot")
	local pData = Kira.GetPlayerData()
	local slotData = slot and pData and pData.Slots and pData.Slots[slot]
	local inv = slotData and slotData.Inventory
	if type(inv) ~= "table" then return 0 end
	local count = 0
	for _, pieceName in ipairs(Kira.TSPieces) do
		local found = false
		if type(inv.Items) == "table" and inv.Items[pieceName] and inv.Items[pieceName] >= 1 then
			found = true
		end
		if not found then
			for _, sub in pairs(inv) do
				if type(sub) == "table" and sub[pieceName] and sub[pieceName] >= 1 then
					found = true
					break
				end
			end
		end
		if found then count = count + 1 end
	end
	return count
end

Kira.TSQuestDone = function()
	if Kira.GetTSInventoryPieceCount() >= #Kira.TSPieces then
		return true
	end
	local count = 0
	for _, q in ipairs(Kira.TSQuestChain) do
		if q.Piece then
			local _, rewarded = Kira.GetTSQuestProgress(q.Tag)
			if rewarded then count = count + 1 end
		end
	end
	return count >= #Kira.TSPieces
end

Kira.CheckTSPreReq = function(quest)
	if not quest.PreReq then return true end
	for _, q in ipairs(Kira.TSQuestChain) do
		if q.Tag == quest.PreReq then
			local cur, rewarded = Kira.GetTSQuestProgress(q.Tag)
			return rewarded or (cur >= q.Amount)
		end
	end
	return true
end

Kira.FindNextTSQuest = function()
	for _, q in ipairs(Kira.TSQuestChain) do
		local cur, rewarded = Kira.GetTSQuestProgress(q.Tag)
		if not rewarded and Kira.CheckTSPreReq(q) then
			return q, cur
		end
	end
	return nil, 0
end

Kira.ClaimTSRewardsAndAdvance = function()
	local claimed = 0
	for _, q in ipairs(Kira.TSQuestChain) do
		local cur, rewarded, exists = Kira.GetTSQuestProgress(q.Tag)
		if exists and not rewarded and cur >= q.Amount then
			local ok, res = pcall(function()
