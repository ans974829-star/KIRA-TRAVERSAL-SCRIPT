local function AutoClaimAchievementsProcessor()
	if not IsToggled("AutoClaimAchievementsGlobalToggle") then return end
	local profile = GetPlayerData()
	if not profile or type(profile.Titles) ~= "table" then return end
	local titleStorage = nil
	pcall(function()
