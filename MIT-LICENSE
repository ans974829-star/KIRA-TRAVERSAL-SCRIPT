local function getRootGui()
    if gethui then
        return gethui()
    elseif syn and syn.protect_gui then
        local g = Instance.new("Folder")
        syn.protect_gui(g)
        g.Parent = game:GetService("CoreGui")
        return g
    elseif game:GetService("CoreGui") then
        return game:GetService("CoreGui")
    else
        return LocalPlayer:WaitForChild("PlayerGui")
    end
end

local existing = getRootGui():FindFirstChild("KiraFullscreenNoticeUI")
if existing then
    existing:Destroy()
end

local function playSound(soundId, pitch, vol)
    task.spawn(function()
        local s = Instance.new("Sound")
        s.SoundId = soundId
        s.Volume = vol or 0.5
        s.Pitch = pitch or 1
        s.Parent = SoundService
        s:Play()
        s.Ended:Connect(function()
            s:Destroy()
        end)
    end)
end

local function tw(obj, props, dur, style, dir)
    local t = TweenService:Create(obj, TweenInfo.new(dur or 0.25, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function copyToClipboard(txt)
    pcall(function()
        if setclipboard then
            setclipboard(txt)
        elseif toclipboard then
            toclipboard(txt)
        end
    end)
end

