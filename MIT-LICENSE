local function FormatTable(tbl)
	local str = ""
	for k, v in pairs(tbl) do str = str .. k .. ": " .. tostring(v) .. "\n" end
	return str ~= "" and str or "None"
end

local function FormatItems(tbl)
	local str = ""
	for name, qty in pairs(tbl) do
		str = str .. "[+] " .. name:gsub("_", " ") .. " (x" .. qty .. ")\n"
	end
	return str ~= "" and str or "None"
end

