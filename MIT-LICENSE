local function revealDescendants(parent)
    for _, child in ipairs(parent:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextButton") or child:IsA("TextBox") then
            local targetBg = child:IsA("TextBox") and 1 or (child.Name == "CloseButton" and 0 or (child.Name == "InputContainer" and 0 or (child.Name == "LetterContainer" and 0 or (child.Name == "FeedbackSection" and 0 or (child.Name == "SubmitBtn" and 0 or (child:IsA("Frame") and child.Name:find("Row") == nil and 0 or 1))))))
            if child.Name == "CloseButton" or child.Name == "SubmitBtn" then targetBg = 0 end
            tw(child, {BackgroundTransparency = targetBg}, 0.4)
        end
        if child:IsA("UIStroke") then
            tw(child, {Transparency = 0}, 0.4)
        end
        if child:IsA("TextLabel") or child:IsA("TextBox") then
            tw(child, {TextTransparency = 0}, 0.4)
        end
        if child:IsA("ImageLabel") then
            tw(child, {ImageTransparency = 0}, 0.4)
        end
        revealDescendants(child)
        task.wait(0.04)
    end
end

