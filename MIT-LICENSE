local function HandleGachaRollingLogic()
	if not IsToggled("AutoRollToggle") then
		pcall(function() getgenv().KiraHub.UI.Labels.Family:SetText("Spin: OFF | Clan: -") end)
		return
	end
	if game.PlaceId ~= MENU_ID then
		pcall(function() Toggles.AutoRollToggle:SetValue(false) end)
		Library:Notify({Title = "Gacha Roller", Description = "You must be in the Main Menu to utilize family rolls", Time = 3})
		return
	end
	local clanTitleLabel = nil
	pcall(function()
		clanTitleLabel = INTERFACE.Customisation.Family.Family.Title
	end)
	if not clanTitleLabel then return end
	local clanString = clanTitleLabel.Text
	if clanString == "" then return end
	local clanCleanName = string.lower(string.split(clanString, " ")[1])
	local clanRarity = string.lower(string.match(clanString, "%((.-)%)") or "")
	local whitelistInput = Options.TargetFamiliesInput and Options.TargetFamiliesInput.Value or ""
	local whitelistedClans = {}
	if whitelistInput ~= "" then
		for _, name in ipairs(string.split(string.lower(whitelistInput), ",")) do
			table.insert(whitelistedClans, string.gsub(name, "^%s*(.-)%s*$", "%1"))
		end
	end
	local stopRarities = {}
	local rSelected = GetOption("SelectFamilyRarity", {})
	if rSelected then
		for rarity, active in pairs(rSelected) do
			if active then stopRarities[string.lower(rarity)] = true end
		end
	end
	local haltGacha = false
	if table.find(whitelistedClans, clanCleanName) then haltGacha = true end
	if stopRarities[clanRarity] then haltGacha = true end
	if clanRarity == "mythical" or clanRarity == "secret" then haltGacha = true end
	if haltGacha then
		pcall(function() Toggles.AutoRollToggle:SetValue(false) end)
		local rareCheck = false
		if clanRarity == "mythical" or clanRarity == "secret" then
			local rareMythicals = {"helos", "fritz", "reiss", "tybur"}
			for _, rare in ipairs(rareMythicals) do
				if string.find(string.lower(clanString), rare) then rareCheck = true break end
			end
		end
		local username = IsToggled("RewardsShowUsernameToggle") and player.Name or "Anonymous"
		local userWebhook = GetSavedRewardsWebhook()
		if IsToggled("ToggleMythicalFamilyWebhook") and userWebhook ~= "" then
			PostWebhook(userWebhook, {
				content = (clanRarity == "mythical" or clanRarity == "secret") and "MYTHICAL GACHA DROP!" or nil,
				embeds = {{
					title = "Family Gacha Roll Success",
					description = "**Target rolled successfully!**",
					color = (clanRarity == "mythical" or clanRarity == "secret") and 16750848 or 3066993,
					fields = {
						{name = "Player", value = username, inline = true},
						{name = "Clan Gained", value = clanString, inline = true},
						{name = "Rare Tier", value = rareCheck and "YES" or "No", inline = true}
					},
					footer = {text = "Kira Hub Gacha Integration"},
					timestamp = DateTime.now():ToIsoDate()
				}}
			})
		end
		Library:Notify({Title = "Gacha Roller", Description = "Rolled targeted clan: " .. clanString, Time = 6})
		return
	end
	pcall(function()
		if INTERFACE:FindFirstChild("Warning") and INTERFACE.Warning.Prompt.Visible then
			UseButton(INTERFACE.Warning.Prompt.Main.Yes)
			task.wait(0.5)
		end
	end)
	pcall(function()
		local custom = INTERFACE:FindFirstChild("Customisation")
		local fam = custom and custom:FindFirstChild("Family")
		if fam and not fam.Visible then
			UseButton(INTERFACE.Customisation.Categories.Family.Interact)
			task.wait(1)
		end
	end)
	pcall(function()
		local custom = INTERFACE:FindFirstChild("Customisation")
		local fam = custom and custom:FindFirstChild("Family")
		local roll = fam and fam:FindFirstChild("Buttons_2") and fam.Buttons_2:FindFirstChild("Roll")
		if roll then UseButton(roll) end
	end)
end

