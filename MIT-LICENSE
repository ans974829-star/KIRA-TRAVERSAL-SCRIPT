			end)
			if ok and res then
				claimed = claimed + 1
				Kira.LastPlayerDataTime = 0
				Kira.GetPlayerData()
			end
		end
	end
	return claimed
end

Kira.CollectTSQuestCrates = function()
	local char = Kira.Player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return 0 end
	local crates = {}
	for _, desc in ipairs(workspace:GetDescendants()) do
		if (desc:IsA("Model") or desc:IsA("BasePart")) and string.find(desc.Name, "ThunderSpear_Supplies") then
			table.insert(crates, desc)
