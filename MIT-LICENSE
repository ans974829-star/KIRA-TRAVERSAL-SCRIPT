local function createRichBlock(text, font, size, color, order, strokeColor)
    local block = Instance.new("TextLabel")
    block.Size = UDim2.new(1, 0, 0, 0)
    block.BackgroundTransparency = 1
    block.Font = font
    block.Text = text
    block.TextColor3 = color
    block.TextSize = size
    block.TextWrapped = true
    block.TextXAlignment = Enum.TextXAlignment.Left
    block.AutomaticSize = Enum.AutomaticSize.Y
    block.LineHeight = 1.35
    block.LayoutOrder = order
    block.TextTransparency = 1
    block.Parent = LetterContainer

    if strokeColor then
        local st = Instance.new("UIStroke")
        st.Color = strokeColor
        st.Thickness = 0.5
        st.Transparency = 1
        st.Parent = block
    end
    return block
end

