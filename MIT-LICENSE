Kira.FindNearestGasTankRefill = function()
	local character = Kira.Player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return nil end
	local nearestPart, minDistance = nil, math.huge
	for _, desc in ipairs(workspace:GetDescendants()) do
		if desc.Name == "GasTanks" and desc:IsA("Model") then
			local prim = desc.PrimaryPart or desc:FindFirstChildWhichIsA("BasePart")
